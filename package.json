{
  "name": "booking-saas",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "turbo run dev --ui=tui",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm --filter=@booking/api prisma:generate && tsc -p tests/tsconfig.json --noEmit && vitest run",
    "test:arch": "vitest run --project architecture",
    "test:api": "vitest run --project api",
    "smoke:local": "node --env-file-if-exists=.env scripts/smoke-local.mjs",
    "smoke:infra:local": "node --env-file-if-exists=.env scripts/smoke-infra-local.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.36.0",
    "vitest": "^3.2.0"
  }
}
