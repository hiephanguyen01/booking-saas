###############################################################################
# BookingOS — deployment env for docker-compose.deploy.yml
#
#   cp .env.deploy.example .env.stg   # then fill in the staging values
#   cp .env.deploy.example .env.prod  # then fill in the production values
#
#   docker compose --env-file .env.stg  -f docker-compose.deploy.yml up -d
#   docker compose --env-file .env.prod -f docker-compose.deploy.yml up -d
#
# This is NOT the root `.env` (that one is for local dev — see .env.example).
# Every value below is read by compose and injected as a container env var; the
# containers never read a .env file.
#
# Compose FAILS FAST on anything marked `:?` in docker-compose.deploy.yml, so a
# missing secret stops the deploy instead of silently falling back to a dev
# default. That is the compose file compensating for the API having no env
# validation of its own.
###############################################################################

# ── Images ───────────────────────────────────────────────────────────────────
# The Deploy workflow REWRITES these three lines in place with the immutable
# `sha-<short>` tag it just pushed, so a later manual `up -d` on the box runs the
# same image that was deployed. Leave the local values here for a hand-built
# stack (`docker compose … up -d --build`); never use a `latest` tag.
API_IMAGE=bookingos/api:local
STOREFRONT_IMAGE=bookingos/storefront:local
DASHBOARD_IMAGE=bookingos/dashboard:local

# ── Hostnames ────────────────────────────────────────────────────────────────
# staging:    admin.stg.bookingos.vn / api.stg.bookingos.vn
# production: admin.bookingos.vn     / api.bookingos.vn
# The storefront is the nginx DEFAULT server and needs no hostname here: it
# serves every tenant domain by Host, including custom domains added later.
DASHBOARD_HOST=admin.stg.bookingos.vn
API_HOST=api.stg.bookingos.vn
# Port nginx publishes on the host. Keep 80 behind a TLS-terminating LB.
HTTP_PORT=80

# ── Public URLs (absolute, https, no trailing slash) ─────────────────────────
PUBLIC_API_URL=https://api.stg.bookingos.vn
DASHBOARD_URL=https://admin.stg.bookingos.vn
# Fallback only, for an affiliate referral link whose tenant has no primary
# domain mapped. Normally the tenant's own hostname wins.
STOREFRONT_URL=https://bookingstudio.stg.bookingos.vn
# Base domain for auto-provisioned tenant subdomains (<slug>.<base>).
PLATFORM_BASE_DOMAIN=stg.bookingos.vn
# How the frontends reach the API inside the compose network. Only change this
# if you split the stack across hosts.
INTERNAL_API_URL=http://api:3000

# ── Postgres ─────────────────────────────────────────────────────────────────
# Three roles, per TONG-QUAN.md §6.3. DATABASE_URL must NOT be a superuser or
# RLS stops applying and tenant isolation is gone.
#
# PRODUCTION — managed instance, hostnames as below.
# STAGING with `-f docker-compose.stg-data.yml` — Postgres runs as a container,
# so use host `postgres` and set POSTGRES_PASSWORD to the same value you put in
# MIGRATE_DATABASE_URL:
#   MIGRATE_DATABASE_URL=postgresql://postgres:<pw>@postgres:5432/bookingos
#   DATABASE_URL=postgresql://app_user:app_user_dev_pw@postgres:5432/bookingos
#   ADMIN_DATABASE_URL=postgresql://app_admin:app_admin_dev_pw@postgres:5432/bookingos
# (the app_user/app_admin passwords there are the ones the RLS migration creates
# when the roles do not exist yet — fine for staging, never for production.)
MIGRATE_DATABASE_URL=postgresql://postgres:CHANGE_ME@db.internal:5432/bookingos
DATABASE_URL=postgresql://app_user:CHANGE_ME@db.internal:5432/bookingos
ADMIN_DATABASE_URL=postgresql://app_admin:CHANGE_ME@db.internal:5432/bookingos

# Only used by docker-compose.stg-data.yml (the containerised Postgres).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bookingos

# ── Redis ────────────────────────────────────────────────────────────────────
# Shared by the API (BullMQ workers, caches) and both frontends (sessions).
# Use rediss:// for TLS on a managed instance.
# STAGING with the overlay: redis://redis:6379
REDIS_URL=redis://redis.internal:6379
# Only used by the overlay. Redis runs `noeviction` there — see that file for why.
REDIS_MAXMEMORY=256mb

# ── Secrets ──────────────────────────────────────────────────────────────────
# Cookie signing key for storefront + dashboard, min 32 chars.
# Generate: openssl rand -base64 48
SESSION_SECRET_CURRENT=CHANGE_ME_min_32_chars
# Set only while rotating; clear it once every old cookie has expired. Leaving it
# blank is fine — an empty value is treated as "not set", not as a 0-char secret.
SESSION_SECRET_PREVIOUS=
# AES-256-GCM master key for tenant gateway credentials at rest.
# Generate: openssl rand -base64 48
# ⚠️ Keep the SAME value across deploys — change it and every stored credential
#    becomes undecryptable. Rotating it requires re-entering every tenant's
#    gateway credentials in Dashboard → Settings.
PAYMENTS_ENC_KEY=CHANGE_ME
SESSION_COOKIE_SECURE=true

# ── Payments ─────────────────────────────────────────────────────────────────
# MUST stay false outside dev — the storefront refuses to boot on true when
# NODE_ENV=production.
ALLOW_MOCK_PAYMENTS=false
PAYMENT_STALE_SEC=600
# Exact bare https origins the storefront may redirect to after checkout.
# Trim this to the gateways you actually enable.
PAYMENT_REDIRECT_ORIGINS=https://pay-sandbox.sepay.vn,https://pay.sepay.vn,https://test-payment.momo.vn,https://payment.momo.vn,https://sbgateway.zalopay.vn,https://gateway.zalopay.vn

# ── Object storage (S3 / R2 — one bucket PER ENVIRONMENT) ────────────────────
# Cloudflare R2 values shown; for AWS S3 use the regional endpoint, a real
# region, and S3_FORCE_PATH_STYLE=false.
#
# S3_ENDPOINT is where the browser PUTs (the signed URL points here).
# S3_PUBLIC_URL is where objects are READ from afterwards. On R2 they are two
# different hosts — the API endpoint is never publicly readable.
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=bookingos-stg
S3_PUBLIC_URL=https://cdn.stg.bookingos.vn
# true for R2/MinIO path-style; false for AWS S3 virtual-hosted URLs.
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SEC=300
# Allowlist for the ORIGIN OF THE PRESIGNED URL — i.e. S3_ENDPOINT, NOT
# S3_PUBLIC_URL. It also becomes the storefront's CSP `connect-src`, so a
# mismatch shows up as a blocked upload with no server-side error.
STORAGE_UPLOAD_ORIGINS=https://<account_id>.r2.cloudflarestorage.com

# ── Email ────────────────────────────────────────────────────────────────────
# With SMTP_HOST unset the sender degrades to log-only and OTP mail vanishes.
EMAIL_FROM=no-reply@bookingos.vn
SMTP_HOST=smtp.provider.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Never expose Swagger publicly in production.
SWAGGER_ENABLED=false
