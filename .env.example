###############################################################################
# BookingOS — single root .env (every app + CLI reads THIS file)
#
# Copy to `.env` and fill in. The values below are the ready-to-run DEV set:
# `cp .env.example .env` then `pnpm dev` works with no edits.
#
# Legend for each variable:
#   dev  — value shipped below works as-is
#   stg  — must change (real host / real secret)
#   prod — must change, and startup FAILS or is UNSAFE if you don't
#
# ⚠️ There is NO env validation in the API at boot. Unlike the storefront (which
#    refuses to start on a bad production env), the API silently falls back to
#    the dev defaults below — including PAYMENTS_ENC_KEY. Everything marked
#    "prod: REQUIRED" must be set explicitly or you ship a known secret.
###############################################################################

# ── Runtime ──────────────────────────────────────────────────────────────────
# dev: development | stg: production | prod: production
# Drives: secure cookies, JSON logs, Swagger off, storefront production guards.
NODE_ENV=development

# ── Postgres — three connections (TONG-QUAN.md §6.3) ─────────────────────────
# Migrations run as superuser; the app uses app_user (RLS-bound) + app_admin
# (BYPASSRLS). Never point DATABASE_URL at a superuser — RLS would not apply.
# dev: as-is | stg+prod: REQUIRED, separate credentials per role
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking
DATABASE_URL=postgresql://app_user:app_user_dev_pw@localhost:5432/booking
ADMIN_DATABASE_URL=postgresql://app_admin:app_admin_dev_pw@localhost:5432/booking

# dev: as-is | stg+prod: REQUIRED (managed Redis; use rediss:// for TLS)
REDIS_URL=redis://localhost:6379

# ── Tenancy ──────────────────────────────────────────────────────────────────
# Base domain for auto-provisioned tenant subdomains (<slug>.<base>).
# dev: bookingos.vn | stg: stg.bookingos.vn | prod: bookingos.vn
PLATFORM_BASE_DOMAIN=bookingos.vn

# Where a tenant points its OWN domain — shown verbatim in the tenant dashboard's
# domain card. Locally these are only cosmetic (nothing resolves to them), but
# leaving IPV4 empty is what makes "Kiểm tra kết nối" answer "chưa trỏ" instead
# of matching against a made-up address.
# CNAME target for a tenant subdomain; defaults to connect.<PLATFORM_BASE_DOMAIN>.
# PLATFORM_STOREFRONT_CNAME=connect.bookingos.vn
# A-record target for an apex domain — the platform's public IPv4. stg+prod: REQUIRED.
# PLATFORM_STOREFRONT_IPV4=

# ── Ports / URLs ─────────────────────────────────────────────────────────────
# API is PORT; the two React Router SSR apps read theirs in vite.config.ts.
PORT=3000
STOREFRONT_PORT=5173
DASHBOARD_PORT=5174
# Optional release identity for Storefront PWA caches. Deploy passes the Git SHA;
# local builds generate an identity automatically when this is omitted.
# STOREFRONT_BUILD_ID=
# Vite dev-server bind address. Set 0.0.0.0 to expose on the LAN. dev only.
# HOST=0.0.0.0

# Server-to-server API base used by both frontends' loaders/actions.
# prod: REQUIRED — storefront refuses to boot on a loopback host.
BACKEND_URL=http://localhost:3000
# Dashboard base URL. The storefront links here after a partner self-registers;
# the dashboard also reads its own value of this to build cross-host console
# links (the "Đổi workspace" switcher, the workspaces directory's per-tenant
# cards) — see apps/dashboard/app/lib/env.server.ts.
# prod: REQUIRED (both apps refuse to boot without it), https, non-loopback.
DASHBOARD_URL=http://localhost:5174
# The platform console host. Anything else that reaches the dashboard is resolved
# as a tenant console host against tenant_domains (kind = dashboard).
DASHBOARD_HOST=localhost
# Storefront base URL — FALLBACK ONLY, for an affiliate referral link when its
# tenant has no primary domain mapped. Normally the tenant's own hostname wins,
# because each tenant storefront has its own domain (§6.1).
PLATFORM_STOREFRONT_URL=http://localhost:5173
# Publicly reachable base URL of THIS API — builds the MoMo IPN callback
# (`{PUBLIC_API_URL}/webhooks/momo`). In dev MoMo cannot reach localhost: use a
# tunnel (ngrok) and put its https URL here when testing the MoMo sandbox.
# prod: REQUIRED, https, publicly resolvable.
PUBLIC_API_URL=http://localhost:3000

# ── Address geocoding — Nominatim / OpenStreetMap ───────────────────────────
# The public endpoint is free for light, user-triggered lookups only. BookingOS
# never uses it for autocomplete, caches results in Redis for 30 days, and
# serializes cache misses to at most one provider request/second per deployment.
# Policy: https://operations.osmfoundation.org/policies/nominatim/
# Replace this URL with a self-hosted or compatible Nominatim instance as usage grows.
GEOCODING_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# dev: the API supplies a development identifier if omitted.
# stg+prod: REQUIRED — identify the real app/version and a contact URL or email.
# GEOCODING_USER_AGENT=BookingOS/1.0 (https://bookingos.vn; ops@bookingos.vn)
# Recommended by Nominatim so operators can contact high-volume callers.
# GEOCODING_CONTACT_EMAIL=ops@bookingos.vn

# ── Session cookies (frontends) ──────────────────────────────────────────────
# Signing key for the storefront + dashboard cookies. Min 32 chars.
# prod: REQUIRED — startup fails on the dev value below, and on <32 chars.
# Rotate by moving the old value to _PREVIOUS and setting a new _CURRENT.
SESSION_SECRET_CURRENT=dev-session-secret-change-me-min-32-chars-long
# SESSION_SECRET_PREVIOUS=previous-secret-used-only-during-cookie-key-rotation
# Legacy alias: an older `SESSION_SECRET=` still works — the dashboard always
# falls back to it, the storefront only outside production. If your .env still
# uses that name it will pass in dev and FAIL at storefront startup on prod.
# Rename it to SESSION_SECRET_CURRENT.
# dev: false | stg+prod: true (storefront refuses false when NODE_ENV=production)
SESSION_COOKIE_SECURE=false

# ── Object storage — MinIO (dev) / S3 / R2 (stg+prod) ────────────────────────
# One-time dev setup (bucket + public-read policy):
#   pnpm --filter=@booking/api storage:init
# stg+prod: REQUIRED — real endpoint, real keys, and a bucket per environment.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=bookingos
# Private tax evidence and certificates. Never expose this bucket through a public URL.
S3_PRIVATE_BUCKET=bookingos-private
# Optional emergency switch; normal operation deletes only expired, unattached tax uploads.
TAX_DOCUMENT_CLEANUP_DISABLED=false
S3_PUBLIC_URL=http://127.0.0.1:9000/bookingos
# true for MinIO/R2 path-style; false for AWS S3 virtual-hosted URLs.
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SEC=300
# Exact bare origins the Storefront accepts for browser PUTs to presigned URLs.
# prod: REQUIRED, at least one https origin; list every upload endpoint in use.
STORAGE_UPLOAD_ORIGINS=http://localhost:9000,http://127.0.0.1:9000

# ── Payments ─────────────────────────────────────────────────────────────────
# Gateway credentials are TENANT-owned and configured in Dashboard → Settings.
# Do NOT add SEPAY_*/PayOS/MoMo credentials here: one process serves many
# tenants, each with its own gateway account.
#
# ⚠️ Master key that encrypts those tenant credentials at rest (AES-256-GCM).
# prod: REQUIRED. There is no guard — leaving the dev value means every stored
# gateway secret is encrypted with a key published in this repo. Generate with
# `openssl rand -base64 48` and keep the SAME value across deploys, or every
# existing tenant credential becomes undecryptable.
PAYMENTS_ENC_KEY=dev-payments-encryption-key-change-me

# Local tenants without a configured gateway use the mock checkout flow.
# dev: true | stg: false | prod: MUST be false (storefront rejects true).
ALLOW_MOCK_PAYMENTS=true
# Shared secret for the mock gateway webhook. Only meaningful with mock payments.
# MOCK_WEBHOOK_SECRET=mock-webhook-secret

# Reconcile pending gateway payments after this many seconds.
PAYMENT_STALE_SEC=600
# Exact gateway origins the Storefront may redirect customers to after checkout.
# prod: REQUIRED, at least one https origin; comma-separated.
# ZaloPay order_url origins — VERIFY the real origin from one sandbox create call
# before going to production.
PAYMENT_REDIRECT_ORIGINS=https://pay-sandbox.sepay.vn,https://pay.sepay.vn,https://test-payment.momo.vn,https://payment.momo.vn,https://sbgateway.zalopay.vn,https://gateway.zalopay.vn

# ── Email (dev: mailpit — SMTP :1025, web UI http://localhost:8025) ──────────
# With SMTP_HOST unset the sender degrades to log-only, so CI needs no SMTP.
# stg+prod: REQUIRED — a real relay, or OTP + booking mail silently vanishes.
EMAIL_FROM=no-reply@bookingos.vn
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_SECURE=true           # stg+prod TLS
# SMTP_USER=                 # stg+prod SMTP auth
# SMTP_PASS=

# ── Logging / docs ───────────────────────────────────────────────────────────
# API logs are pretty-printed outside production by default. Set false for JSON
# locally, or true to force pretty logs elsewhere.
# LOG_PRETTY=true
# LOG_LEVEL=info
# Swagger is served outside production automatically. Set true to expose it in a
# production build — do NOT enable on prod unless the route is protected.
# SWAGGER_ENABLED=true

# ── Background workers — set true only to silence one during maintenance ─────
# OUTBOX_RELAY_DISABLED=true          # also stops the reminder worker
# NOTIFICATION_REMINDER_DISABLED=true
# BOOKING_SCHEDULER_DISABLED=true     # no-show / auto-complete transitions
# SETTLEMENT_RELEASE_DISABLED=true    # post-dispute settlement release

# ── Seeding ──────────────────────────────────────────────────────────────────
# SEED_SCOPE=tenants seeds the PRODUCTION shape: permissions, roles, admin,
# plans and both tenants' settings (domains, theme, subscription, owner,
# cancellation policy, commission rules, listing types) — no partners, listings
# or bookings. Anything else (the default) also seeds the dev/staging demo data.
#
#   prod:  SEED_SCOPE=tenants SEED_OWNER_PASSWORD=… pnpm --filter=@booking/api seed
#   dev:   pnpm --filter=@booking/api seed
# SEED_SCOPE=tenants

# Platform Super Admin. prod: REQUIRED — override BOTH, the defaults are public.
SEED_ADMIN_EMAIL=admin@bookingos.local
SEED_ADMIN_PASSWORD=admin-dev-password
# Tenant-owner password. REQUIRED when SEED_SCOPE=tenants — the seed refuses to
# run rather than create a real owner with the shared demo password.
# SEED_OWNER_PASSWORD=
# Password for the demo partner/customer accounts. dev/stg only.
# SEED_DEMO_PASSWORD=demo-password
