# Postgres — three connections (see TONG-QUAN.md §6.3)
# migrations run as superuser; the app uses app_user (RLS-bound) + app_admin (BYPASSRLS)
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking
DATABASE_URL=postgresql://app_user:app_user_dev_pw@localhost:5432/booking
ADMIN_DATABASE_URL=postgresql://app_admin:app_admin_dev_pw@localhost:5432/booking

REDIS_URL=redis://localhost:6379

# Tenancy — base domain for auto-provisioned tenant subdomains (<slug>.<base>)
PLATFORM_BASE_DOMAIN=bookify.vn

# Auth
SESSION_COOKIE_SECURE=false

# App ports (API is PORT; the two React Router SSR apps read these in vite.config.ts)
PORT=3000
STOREFRONT_PORT=5173
DASHBOARD_PORT=5174
# API logs are pretty-printed outside production by default. Set false for JSON locally,
# or true to explicitly enable pretty logs in another environment.
# LOG_PRETTY=true
# LOG_LEVEL=info
SESSION_SECRET_CURRENT=dev-session-secret-change-me-min-32-chars-long
# SESSION_SECRET_PREVIOUS=previous-secret-used-only-during-cookie-key-rotation
BACKEND_URL=http://localhost:3000
# Dashboard base URL — storefront links here after a partner self-registers (become-partner).
DASHBOARD_URL=http://localhost:5174
# Storefront base URL — FALLBACK ONLY, for building an affiliate's referral link when
# its tenant has no primary domain mapped. A referral link normally uses the tenant's
# own hostname (`tenantHostname` on /affiliate/me), because each tenant storefront has
# its own domain (§6.1) and no single URL can be correct for all of them.
STOREFRONT_URL=http://localhost:5173

# ── Object storage — MinIO (dev) / S3 / R2 (prod) — Task 1.4 image upload ──
# One-time dev setup (creates the bucket + public-read policy): pnpm --filter=api storage:init
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=bookify
S3_PUBLIC_URL=http://127.0.0.1:9000/bookify
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SEC=300
# Exact bare origins accepted by the Storefront for browser PUTs to presigned storage URLs.
# Production requires at least one HTTPS origin; include every S3/R2 upload endpoint in use.
STORAGE_UPLOAD_ORIGINS=http://localhost:9000,http://127.0.0.1:9000

# Local tenants without a configured gateway use the mock checkout flow.
# Production rejects this value at storefront startup.
ALLOW_MOCK_PAYMENTS=true
# Payment credentials are tenant-owned and configured in Dashboard → Settings.
# Do NOT add SEPAY_MERCHANT_ID/SEPAY_SECRET_KEY or PayOS credentials here: a
# single process serves multiple tenants, each with a different gateway account.
# Master key used to encrypt those tenant credentials at rest. Use a long,
# randomly generated secret in production and keep the same value during deploys.
PAYMENTS_ENC_KEY=dev-payments-encryption-key-change-me
# Reconcile pending gateway payments after this many seconds.
PAYMENT_STALE_SEC=600
# Disable only the post-dispute settlement release worker during maintenance.
# SETTLEMENT_RELEASE_DISABLED=true
# Exact gateway origins the Storefront may redirect customers to after checkout.
# Production requires at least one HTTPS origin; separate multiple origins with commas.
# ZaloPay order_url origins — VERIFY origin thật từ 1 lệnh create sandbox trước khi prod.
PAYMENT_REDIRECT_ORIGINS=https://pay-sandbox.sepay.vn,https://pay.sepay.vn,https://test-payment.momo.vn,https://payment.momo.vn,https://sbgateway.zalopay.vn,https://gateway.zalopay.vn
# Publicly reachable base URL of THIS API — used to build the MoMo IPN callback
# (`{PUBLIC_API_URL}/webhooks/momo`). In dev, MoMo can't reach localhost: use a
# tunnel (e.g. ngrok) and set its https URL here when testing MoMo sandbox.
PUBLIC_API_URL=http://localhost:3000

# ── Email (Task 1.16 — mailpit in dev: SMTP :1025, web UI http://localhost:8025) ──
# With SMTP_HOST unset the sender degrades to log-only (so CI needs no SMTP).
EMAIL_FROM=no-reply@bookify.vn
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_SECURE=false          # true for prod TLS
# SMTP_USER=                 # prod SMTP auth
# SMTP_PASS=
# Silence the outbox relay + reminder worker if needed:
# OUTBOX_RELAY_DISABLED=true
# NOTIFICATION_REMINDER_DISABLED=true
