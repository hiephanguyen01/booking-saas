// ─────────────────────────────────────────────────────────────────────────────
// 7.1 Identity & Access
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  email            String     @unique @db.Citext
  /// Null for guest-checkout users (§8.6) — they authenticate by booking code + email OTP.
  passwordHash     String?    @map("password_hash")
  fullName         String     @map("full_name")
  phone            String?
  /// Profile photo publicUrl from a presigned upload (§4.2); null when unset.
  avatarUrl        String?    @map("avatar_url")
  locale           String     @default("vi")
  status           UserStatus @default(active)
  emailVerifiedAt  DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions                 Session[]
  roleAssignments          RoleAssignment[]
  bookings                 Booking[]              @relation("CustomerBookings")
  affiliates               Affiliate[]
  partnerMemberships       PartnerMember[]
  staffProfiles            Staff[]
  reviewsWritten           Review[]               @relation("ReviewCustomer")
  reviewRepliesAuthored    ReviewReply[]          @relation("ReviewReplyAuthor")
  favorites                Favorite[]             @relation("FavoriteCustomer")
  contentReports           ContentReport[]        @relation("ContentReportReporter")
  contentReportsHandled    ContentReport[]        @relation("ContentReportHandler")
  listingRevisions         ListingRevision[]      @relation("ListingRevisionSubmitter")
  listingRevisionsReviewed ListingRevision[]      @relation("ListingRevisionReviewer")
  agreementAcceptances     AgreementAcceptance[]
  legalVersionsPublished   LegalDocumentVersion[]

  @@map("users")
}

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  accessTokenHash  String    @unique @map("access_token_hash")
  accessExpiresAt  DateTime  @map("access_expires_at") @db.Timestamptz(6)
  refreshTokenHash String    @unique @map("refresh_token_hash")
  refreshExpiresAt DateTime  @map("refresh_expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  ip               String?
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Permission {
  key         String     @id
  scopeLevel  ScopeLevel @map("scope_level")
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id         String     @id @default(uuid(7)) @db.Uuid
  name       String
  scopeLevel ScopeLevel @map("scope_level")
  tenantId   String?    @map("tenant_id") @db.Uuid
  partnerId  String?    @map("partner_id") @db.Uuid
  isSystem   Boolean    @default(false) @map("is_system")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  roleAssignments RoleAssignment[]

  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model RoleAssignment {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  partnerId String?  @map("partner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // uniqueness (user, role, tenant, partner) with NULLS NOT DISTINCT is added
  // in the hand-written RLS migration — Prisma cannot express it
  @@index([userId])
  @@index([tenantId])
  @@map("role_assignments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Global reference data — Decision 19/2025/QĐ-TTg (effective 2025-07-01)
// ─────────────────────────────────────────────────────────────────────────────

model AdministrativeProvince {
  code          String                     @id @db.Char(2)
  name          String
  type          AdministrativeProvinceType
  sortOrder     Int                        @map("sort_order")
  effectiveFrom DateTime                   @map("effective_from") @db.Date
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  wards AdministrativeWard[]

  @@index([sortOrder])
  @@map("administrative_provinces")
}

model AdministrativeWard {
  code          String                 @id @db.Char(5)
  provinceCode  String                 @map("province_code") @db.Char(2)
  name          String
  type          AdministrativeWardType
  sortOrder     Int                    @map("sort_order")
  effectiveFrom DateTime               @map("effective_from") @db.Date
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  province AdministrativeProvince @relation(fields: [provinceCode], references: [code], onDelete: Restrict)

  @@index([provinceCode, sortOrder])
  @@map("administrative_wards")
}

// ─────────────────────────────────────────────────────────────────────────────
// 7.2 Tenancy
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id                          String           @id @default(uuid(7)) @db.Uuid
  name                        String
  slug                        String           @unique
  status                      TenantStatus     @default(active)
  defaultTimezone             String           @default("Asia/Ho_Chi_Minh") @map("default_timezone")
  defaultLocale               String           @default("vi") @map("default_locale")
  /// Storefront base template only (§16.1); the real menu comes from listing_types.
  vertical                    String           @default("studio")
  /// The tenant's own VAT status (§VAT) — governs a HOUSE partner's booking,
  /// where the tenant is the seller of record rather than a commission agent.
  taxStatus                   PartnerTaxStatus @default(company_vat) @map("tax_status")
  themeConfig                 Json             @default("{}") @map("theme_config")
  settings                    Json             @default("{}")
  /// Tenant-level fallback cancellation policy (§11.3) applied when a listing and its
  /// partner set none. Points at a tenant-level policy (partner_id null).
  defaultCancellationPolicyId String?          @map("default_cancellation_policy_id") @db.Uuid
  /// Stamped by the legal-readiness outbox handler when all four required
  /// documents are published in the tenant's defaultLocale; cleared otherwise.
  /// The storefront hard gate keys on this being non-null.
  legalReadyAt                DateTime?        @map("legal_ready_at") @db.Timestamptz(6)
  /// How many of the four required documents are published in defaultLocale (0-4).
  legalDocumentsReady         Int              @default(0) @map("legal_documents_ready") @db.SmallInt
  /// Emit time (DB clock) of the newest `legal.readiness_changed` event already
  /// applied to the two columns above. Outbox delivery is at-least-once and out
  /// of order — a failed event backs off while newer ones drain — so the two
  /// columns are only overwritten by an event at least this new. Without it a
  /// retried stale snapshot could reopen the storefront gate on a withdrawn
  /// document and nothing would ever correct it.
  legalReadinessAt            DateTime?        @map("legal_readiness_at") @db.Timestamptz(6)
  createdAt                   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  domains                   TenantDomain[]
  invitations               TenantInvitation[]
  subscriptions             TenantSubscription[]
  roles                     Role[]
  roleAssignments           RoleAssignment[]
  agreementAcceptances      AgreementAcceptance[]
  partners                  Partner[]
  listingTypes              ListingType[]
  listingGroups             ListingGroup[]
  resources                 Resource[]
  listings                  Listing[]
  categories                Category[]
  cancellationPolicies      CancellationPolicy[]       @relation("TenantPolicies")
  defaultCancellationPolicy CancellationPolicy?        @relation("TenantDefaultPolicy", fields: [defaultCancellationPolicyId], references: [id], onDelete: SetNull)
  bookings                  Booking[]
  payments                  Payment[]
  refundBatches             RefundBatch[]
  manualRefundOperations    ManualRefundOperation[]
  gatewayConfigs            TenantGatewayConfig[]
  commissionRules           CommissionRule[]
  ledgerAccounts            LedgerAccount[]
  payouts                   Payout[]
  bookingSettlements        BookingSettlement[]
  settlementDisputes        SettlementDispute[]
  reviews                   Review[]
  reviewReplies             ReviewReply[]
  favorites                 Favorite[]
  contentReports            ContentReport[]
  listingRevisions          ListingRevision[]
  payoutAllocations         PayoutAllocation[]
  promotions                Promotion[]
  affiliates                Affiliate[]
  legalDocuments            LegalDocument[]
  legalDocumentVersions     LegalDocumentVersion[]
  legalDocumentTranslations LegalDocumentTranslation[]
  partnerTaxAssessments     PartnerTaxYearAssessment[]
  partnerTaxRevenueEvents   PartnerTaxRevenueEvent[]
  partnerTaxDeclarations    PartnerTaxDeclaration[]
  taxWithholdingEvents      TaxWithholdingEvent[]
  taxFilingPeriods          TaxFilingPeriod[]
  taxRemittances            TaxRemittance[]
  taxCertificates           TaxWithholdingCertificate[]
  taxDocumentUploads        TaxDocumentUpload[]

  paymentMethodRoutes       TenantPaymentMethodRoute[]
  refundPolicy              TenantRefundPolicy?
  @@map("tenants")
}

model TenantDomain {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  hostname          String    @unique @db.Citext
  isPrimary         Boolean   @default(false) @map("is_primary")
  kind              TenantDomainKind @default(storefront)
  /// TXT value the tenant publishes to prove ownership of a custom domain (§6.1). Null once verified/for subdomains.
  verificationToken String?   @map("verification_token")
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  // Matches migration 20260812000000_tenant_domain_kind's `tenant_domains_kind_idx`
  // (kept only to resolve `migrate diff` drift between the model and the
  // database — every query pairs `kind` with `tenant_id` or `hostname`, so the
  // index itself is unused; dropping it needs its own migration).
  @@index([kind])
  @@map("tenant_domains")
}

enum TenantInvitationStatus {
  pending
  accepted
  revoked

  @@map("tenant_invitation_status")
}

/// A pending invitation for someone to join a tenant with a set of roles.
/// `roleIds` is an array rather than a join table: an invitation lives 7 days,
/// and accept-time intersection against the tenant's live roles covers a role
/// deleted in the meantime.
model TenantInvitation {
  id              String                 @id @default(uuid(7)) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  partnerId       String?                @map("partner_id") @db.Uuid
  email           String                 @db.Citext
  roleIds         String[]               @map("role_ids") @db.Uuid
  tokenHash       String                 @unique @map("token_hash")
  invitedByUserId String?                @map("invited_by_user_id") @db.Uuid
  status          TenantInvitationStatus @default(pending)
  expiresAt       DateTime               @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime?              @map("accepted_at") @db.Timestamptz(6)
  acceptedUserId  String?                @map("accepted_user_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // one live invitation per (tenant, partner, email) with NULLS NOT DISTINCT — so a
  // tenant-scope row (partnerId NULL) still collides with another tenant-scope row to the
  // same address — is added in the hand-written migration; Prisma cannot express it
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("tenant_invitations")
}

/// Proof-of-acceptance for partner terms / commission schedules / promo funding (§7.2).
model AgreementAcceptance {
  id                String        @id @default(uuid(7)) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  userId            String?       @map("user_id") @db.Uuid
  partnerId         String?       @map("partner_id") @db.Uuid
  agreementType     AgreementType @map("agreement_type")
  version           String
  acceptedAt        DateTime      @default(now()) @map("accepted_at") @db.Timestamptz(6)
  ip                String?
  /// The exact tenant-authored version accepted. Null for commission_schedule / promo_funding.
  documentVersionId String?       @map("document_version_id") @db.Uuid
  /// The language actually rendered on screen when the person clicked, fallback included.
  acceptedLocale    String?       @map("accepted_locale")

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner         Partner?              @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user            User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentVersion LegalDocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([partnerId])
  @@index([tenantId, userId, agreementType])
  @@index([documentVersionId])
  @@map("agreement_acceptances")
}

/// One legal document per type per tenant. `currentVersionId` points at the
/// published version the storefront serves; null means never published.
model LegalDocument {
  id               String            @id @default(uuid(7)) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  docType          LegalDocumentType @map("doc_type")
  currentVersionId String?           @map("current_version_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currentVersion LegalDocumentVersion?  @relation("LegalDocumentCurrent", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       LegalDocumentVersion[] @relation("LegalDocumentVersions")

  @@unique([tenantId, docType])
  @@index([tenantId])
  @@map("legal_documents")
}

/// An immutable published version, or the single draft (published_at null).
/// Every publish creates a new row; `isMaterialChange` decides who re-accepts.
/// INVARIANT NOT EXPRESSIBLE HERE: at most one draft per document is enforced by
/// the partial unique index `legal_document_versions_draft_key`
/// (UNIQUE (document_id) WHERE published_at IS NULL), created by hand in
/// migrations/20260731140000_tenant_legal_documents/migration.sql. Prisma cannot
/// express partial unique indexes, so `prisma migrate dev` / `db push` against
/// this schema would silently drop it — both are forbidden by ADR 0004.
model LegalDocumentVersion {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  documentId        String    @map("document_id") @db.Uuid
  versionNo         Int       @map("version_no")
  isMaterialChange  Boolean   @default(false) @map("is_material_change")
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(6)
  publishedByUserId String?   @map("published_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document     LegalDocument              @relation("LegalDocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  publishedBy  User?                      @relation(fields: [publishedByUserId], references: [id], onDelete: SetNull)
  translations LegalDocumentTranslation[]
  currentOf    LegalDocument[]            @relation("LegalDocumentCurrent")
  acceptances  AgreementAcceptance[]

  @@unique([documentId, versionNo])
  @@index([tenantId])
  @@map("legal_document_versions")
}

/// One rendering of a version. A version is the agreement; vi and en of v3 are
/// one contract in two languages, which is why locale lives here and not above.
model LegalDocumentTranslation {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  versionId String   @map("version_id") @db.Uuid
  locale    String
  title     String
  bodyMd    String   @map("body_md")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version LegalDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, locale])
  @@index([tenantId])
  @@map("legal_document_translations")
}

/// Platform-owned Vietnamese VAT schedule (§VAT). GLOBAL reference data —
/// deliberately no `tenant_id`, no RLS: the rate is national law, identical for
/// every tenant, so a law change must be one row edit rather than a fan-out
/// across tenants. At most one row may cover a given (category, instant).
model TaxRate {
  id            String      @id @default(uuid(7)) @db.Uuid
  category      TaxCategory
  /// VAT in basis points — 800 = 8%, 1000 = 10%. Matches `percentOfBps`.
  rateBps       Int         @map("rate_bps")
  effectiveFrom DateTime    @map("effective_from") @db.Timestamptz(6)
  /// Exclusive upper bound; null = still in force.
  effectiveTo   DateTime?   @map("effective_to") @db.Timestamptz(6)
  /// The instrument this rate comes from, e.g. 'NQ 204/2025/QH15'.
  legalRef      String      @map("legal_ref")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([category, effectiveFrom])
  @@index([category, effectiveFrom])
  @@map("tax_rates")
}

/// NĐ 117/2025 withholding schedule. GLOBAL reference data — no `tenant_id`, no
/// RLS. Rates are what the payment-function operator withholds from a household
/// or individual seller and remits on their behalf.
model WithholdingRate {
  id            String    @id @default(uuid(7)) @db.Uuid
  /// `service` | `goods` | `transport` — only `service` is used today.
  activity      String
  /// VAT withheld, basis points. 500 = 5%.
  vatBps        Int       @map("vat_bps")
  /// Personal income tax withheld, basis points. 200 = 2%.
  pitBps        Int       @map("pit_bps")
  effectiveFrom DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(6)
  legalRef      String    @map("legal_ref")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([activity, effectiveFrom])
  @@map("withholding_rates")
}

/// Effective-dated national annual-revenue threshold. GLOBAL reference data —
/// no `tenant_id` or RLS. Superseded rows remain for audit when a later legal
/// instrument changes a threshold retroactively.
model TaxThresholdRule {
  id              String    @id @default(uuid(7)) @db.Uuid
  code            String
  thresholdAmount BigInt    @map("threshold_amount")
  effectiveFrom   DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo     DateTime? @map("effective_to") @db.Timestamptz(6)
  publishedAt     DateTime  @map("published_at") @db.Timestamptz(6)
  legalRef        String    @map("legal_ref")
  revision        Int       @default(1)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  assessments PartnerTaxYearAssessment[]

  @@unique([code, effectiveFrom, revision])
  @@index([code, isActive, effectiveFrom])
  @@map("tax_threshold_rules")
}

model SubscriptionPlan {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String   @unique
  priceMonthly BigInt   @map("price_monthly")
  /// { maxPartners, maxListings, maxBookingsPerMonth, customDomain, affiliateModule } (§6.5).
  limits       Json     @default("{}")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions TenantSubscription[]

  @@map("subscription_plans")
}

model TenantSubscription {
  id        String             @id @default(uuid(7)) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  planId    String             @map("plan_id") @db.Uuid
  status    SubscriptionStatus @default(trial)
  startsAt  DateTime           @map("starts_at") @db.Timestamptz(6)
  expiresAt DateTime           @map("expires_at") @db.Timestamptz(6)
  note      String?
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@map("tenant_subscriptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// 7.3 Catalog
// ─────────────────────────────────────────────────────────────────────────────

model Partner {
  id                          String                    @id @default(uuid(7)) @db.Uuid
  tenantId                    String                    @map("tenant_id") @db.Uuid
  name                        String
  slug                        String
  description                 String?
  partnerType                 PartnerType               @default(individual) @map("partner_type")
  /// Tenant-owned inventory: no partner payable/payout, platform fee on GMV (§7.3).
  isHouse                     Boolean                   @default(false) @map("is_house")
  status                      PartnerStatus             @default(pending)
  /// tax ID / business registration for a `company` partner.
  businessInfo                Json                      @default("{}") @map("business_info")
  /// Whether this partner charges output VAT (§VAT). Defaults to the 0%-VAT
  /// status so enabling the feature can never silently move money on an
  /// existing row — a tenant opts a partner in explicitly.
  taxStatus                   PartnerTaxStatus          @default(household_below_threshold) @map("tax_status")
  contactInfo                 Json                      @default("{}") @map("contact_info")
  /// bank account for receiving payouts.
  payoutInfo                  Json                      @default("{}") @map("payout_info")
  /// national ID / DOB verification for people-booking listing types (§7.3).
  verifiedAt                  DateTime?                 @map("verified_at") @db.Timestamptz(6)
  /// manual-review state; `verified` (with verifiedAt set) unlocks people-booking types.
  verificationStatus          PartnerVerificationStatus @default(unsubmitted) @map("verification_status")
  /// date of birth for the under-18 block on people-booking types (§7.3).
  dateOfBirth                 DateTime?                 @map("date_of_birth") @db.Date
  /// { documentType, documentNumber, holderName, reviewedBy, reviewNote } — manual eKYC (Phase 3 automates).
  identityInfo                Json                      @default("{}") @map("identity_info")
  /// Partner-level fallback cancellation policy (§11.3) applied when a listing sets none.
  defaultCancellationPolicyId String?                   @map("default_cancellation_policy_id") @db.Uuid
  createdAt                   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members                   PartnerMember[]
  listingGroups             ListingGroup[]
  resources                 Resource[]
  listings                  Listing[]
  bookings                  Booking[]
  commissionRules           CommissionRule[]
  bookingSettlements        BookingSettlement[]
  staff                     Staff[]
  promotions                Promotion[]                @relation("PartnerCreatedPromotions")
  fundedPromotions          Promotion[]                @relation("PartnerFundedPromotions")
  agreementAcceptances      AgreementAcceptance[]
  reviews                   Review[]
  reviewReplies             ReviewReply[]
  favorites                 Favorite[]
  contentReports            ContentReport[]
  cancellationPolicies      CancellationPolicy[]       @relation("PartnerPolicies")
  defaultCancellationPolicy CancellationPolicy?        @relation("PartnerDefaultPolicy", fields: [defaultCancellationPolicyId], references: [id], onDelete: SetNull)
  taxYearAssessments        PartnerTaxYearAssessment[]
  taxRevenueEvents          PartnerTaxRevenueEvent[]
  taxDeclarations           PartnerTaxDeclaration[]
  taxWithholdingEvents      TaxWithholdingEvent[]
  taxCertificates           TaxWithholdingCertificate[]
  invitations               TenantInvitation[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([defaultCancellationPolicyId])
  @@map("partners")
}

/// Per-partner, per-calendar-year projection used to decide the household VAT
/// regime. Tenant-scoped because both the revenue and declaration are private.
model PartnerTaxYearAssessment {
  id                   String                         @id @default(uuid(7)) @db.Uuid
  tenantId             String                         @map("tenant_id") @db.Uuid
  partnerId            String                         @map("partner_id") @db.Uuid
  taxYear              Int                            @map("tax_year")
  status               PartnerTaxAssessmentStatus     @default(missing_declaration)
  platformRevenue      BigInt                         @default(0) @map("platform_revenue")
  externalRevenue      BigInt                         @default(0) @map("external_revenue")
  thresholdAmount      BigInt                         @map("threshold_amount")
  thresholdRuleId      String                         @map("threshold_rule_id") @db.Uuid
  crossedAt            DateTime?                      @map("crossed_at") @db.Timestamptz(6)
  crossedQuarter       Int?                           @map("crossed_quarter")
  classificationSource PartnerTaxClassificationSource @default(automatic_threshold) @map("classification_source")
  manualOverrideStatus PartnerTaxStatus?              @map("manual_override_status")
  manualOverrideReason String?                        @map("manual_override_reason")
  manualOverrideBy     String?                        @map("manual_override_by") @db.Uuid
  manualOverrideUntil  DateTime?                      @map("manual_override_until") @db.Timestamptz(6)
  declarationUpdatedAt DateTime?                      @map("declaration_updated_at") @db.Timestamptz(6)
  evaluatedAt          DateTime                       @default(now()) @map("evaluated_at") @db.Timestamptz(6)
  version              Int                            @default(1)
  createdAt            DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner       Partner                  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  thresholdRule TaxThresholdRule         @relation(fields: [thresholdRuleId], references: [id], onDelete: Restrict)
  revenueEvents PartnerTaxRevenueEvent[]
  declarations  PartnerTaxDeclaration[]

  @@unique([tenantId, partnerId, taxYear])
  @@index([tenantId, taxYear, status])
  @@index([partnerId, taxYear])
  @@map("partner_tax_year_assessments")
}

/// Append-only signed revenue facts. The source key makes at-least-once outbox
/// delivery safe: a settlement journal or clawback can affect the year once.
model PartnerTaxRevenueEvent {
  id           String                  @id @default(uuid(7)) @db.Uuid
  tenantId     String                  @map("tenant_id") @db.Uuid
  partnerId    String                  @map("partner_id") @db.Uuid
  assessmentId String                  @map("assessment_id") @db.Uuid
  sourceType   PartnerTaxRevenueSource @map("source_type")
  sourceId     String                  @map("source_id")
  amount       BigInt
  serviceDate  DateTime                @map("service_date") @db.Timestamptz(6)
  metadata     Json                    @default("{}")
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner    Partner                  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  assessment PartnerTaxYearAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceType, sourceId])
  @@index([tenantId, partnerId, serviceDate])
  @@index([assessmentId, createdAt])
  @@map("partner_tax_revenue_events")
}

/// Immutable history of partner/tenant declarations of revenue earned outside
/// BookingOS. The latest row becomes the assessment projection.
model PartnerTaxDeclaration {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  partnerId        String   @map("partner_id") @db.Uuid
  assessmentId     String   @map("assessment_id") @db.Uuid
  externalRevenue  BigInt   @map("external_revenue")
  declaredByUserId String   @map("declared_by_user_id") @db.Uuid
  note             String?
  declaredAt       DateTime @default(now()) @map("declared_at") @db.Timestamptz(6)

  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner    Partner                  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  assessment PartnerTaxYearAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, partnerId, declaredAt])
  @@index([assessmentId, declaredAt])
  @@map("partner_tax_declarations")
}

/// Membership of a user in a partner org; the actual role lives in role_assignments.
model PartnerMember {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  partnerId String   @map("partner_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partnerId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("partner_members")
}

/// A tenant-defined service category (dynamic, not hard-coded) — §7.3.
model ListingType {
  tenantId                     String           @map("tenant_id") @db.Uuid
  id                           String           @id @default(uuid(7)) @db.Uuid
  name                         String
  slug                         String
  icon                         String?
  /// uploaded icon image URL (presign publicUrl); takes precedence over the lucide `icon`.
  iconImageUrl                 String?          @map("icon_image_url")
  /// which BookingModes this type may enable / enables by default on a new listing.
  allowedModes                 BookingMode[]    @map("allowed_modes")
  defaultModes                 BookingMode[]    @map("default_modes")
  bookingSelection             BookingSelection @default(flexible_duration) @map("booking_selection")
  /// [{key,label,type,required,filterable,options}] — validates listing.attributes.
  attributeSchema              Json             @default("[]") @map("attribute_schema")
  /// storefront search controls/facet presentation for this tenant-defined type.
  searchConfig                 Json             @default("{}") @map("search_config")
  /// price display unit: "hour", "day", "session", "set"…
  unitLabel                    String?          @map("unit_label")
  /// people-booking type (models, makeup): the partner must be identity-verified to serve it (§7.3, Task 1.2/1.3).
  requiresIdentityVerification Boolean          @default(false) @map("requires_identity_verification")
  /// VAT treatment of everything sold under this type (§VAT). The tenant sets
  /// the category; the platform owns the rate it maps to.
  taxCategory                  TaxCategory      @default(standard) @map("tax_category")
  structure                    ListingStructure @default(standalone)
  itemLabel                    String?          @map("item_label")
  sortOrder                    Int              @default(0) @map("sort_order")
  isActive                     Boolean          @default(true) @map("is_active")
  createdAt                    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listingGroups   ListingGroup[]
  listings        Listing[]
  commissionRules CommissionRule[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("listing_types")
}

/// A "parent" post grouping multiple child listings (rooms/packages) — display +
/// moderation layer only; customers book the child listing, never the group (§7.3).
model ListingGroup {
  id            String           @id @default(uuid(7)) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  partnerId     String           @map("partner_id") @db.Uuid
  listingTypeId String           @map("listing_type_id") @db.Uuid
  title         String
  slug          String
  description   String?
  provinceCode  String?          @map("province_code") @db.Char(2)
  provinceName  String?          @map("province_name")
  wardCode      String?          @map("ward_code") @db.Char(5)
  wardName      String?          @map("ward_name")
  address       String?
  latitude      Float?           @db.DoublePrecision
  longitude     Float?           @db.DoublePrecision
  workingArea   String?          @map("working_area")
  photos        Json             @default("[]")
  /// post-level amenities (reception, parking…) — distinct from listing attributes.
  amenities     Json             @default("[]")
  status        PublishStatus    @default(draft)
  publishedBy   ModerationActor? @map("published_by")
  hiddenBy      ModerationActor? @map("hidden_by")
  ratingAvg     Decimal?         @map("rating_avg") @db.Decimal(3, 2)
  reviewCount   Int              @default(0) @map("review_count")
  bookingCount  Int              @default(0) @map("booking_count")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner     Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  listingType ListingType @relation(fields: [listingTypeId], references: [id])
  listings    Listing[]
  reviews     Review[]
  favorites   Favorite[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([partnerId])
  @@index([tenantId, provinceCode, wardCode])
  @@map("listing_groups")
}

/// The calendar-holding unit. Multiple listings pointing at one resource share a
/// single calendar and can never double-book (§7.3).
model Resource {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  partnerId String   @map("partner_id") @db.Uuid
  name      String
  timezone  String   @default("Asia/Ho_Chi_Minh")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner                Partner                 @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  listings               Listing[]
  bookings               Booking[]
  availabilityExceptions AvailabilityException[]

  @@index([tenantId])
  @@index([partnerId])
  @@map("resources")
}

model Listing {
  id                      String           @id @default(uuid(7)) @db.Uuid
  tenantId                String           @map("tenant_id") @db.Uuid
  partnerId               String           @map("partner_id") @db.Uuid
  listingTypeId           String           @map("listing_type_id") @db.Uuid
  resourceId              String           @map("resource_id") @db.Uuid
  groupId                 String?          @map("group_id") @db.Uuid
  categoryId              String?          @map("category_id") @db.Uuid
  title                   String
  slug                    String
  description             String?
  provinceCode            String?          @map("province_code") @db.Char(2)
  provinceName            String?          @map("province_name")
  wardCode                String?          @map("ward_code") @db.Char(5)
  wardName                String?          @map("ward_name")
  address                 String?
  latitude                Float?           @db.DoublePrecision
  longitude               Float?           @db.DoublePrecision
  photos                  Json             @default("[]")
  /// attribute values, validated against the listing type's attribute_schema.
  attributes              Json             @default("{}")
  /// enabled modes, bounded by listing_type.allowed_modes.
  bookingModes            BookingMode[]    @map("booking_modes")
  /// per-mode config: flexible unit pricing or fixed packages, min/max, granularity, deposit… (§7.3).
  modeConfig              Json             @default("{}") @map("mode_config")
  /// units in stock — `inventory` mode only.
  stockQuantity           Int?             @map("stock_quantity")
  /// max guests; class = number of seats.
  capacity                Int?
  bufferBefore            Int              @default(0) @map("buffer_before")
  bufferAfter             Int              @default(0) @map("buffer_after")
  approvalRequired        Boolean          @default(false) @map("approval_required")
  /// 0–100; 100 = pay in full.
  depositPercent          Int              @default(100) @map("deposit_percent")
  balanceDue              BalanceDue       @default(online_before) @map("balance_due")
  rescheduleAllowed       Boolean          @default(false) @map("reschedule_allowed")
  rescheduleDeadlineHours Int?             @map("reschedule_deadline_hours")
  rescheduleFee           BigInt?          @map("reschedule_fee")
  cancellationPolicyId    String?          @map("cancellation_policy_id") @db.Uuid
  status                  PublishStatus    @default(draft)
  publishedBy             ModerationActor? @map("published_by")
  hiddenBy                ModerationActor? @map("hidden_by")
  /// set when the listing enters `pending_review`; null while it is still a draft.
  submittedAt             DateTime?        @map("submitted_at") @db.Timestamptz(6)
  /// set when the listing first reaches `published`; survives a later archive/hide.
  publishedAt             DateTime?        @map("published_at") @db.Timestamptz(6)
  ratingAvg               Decimal?         @map("rating_avg") @db.Decimal(3, 2)
  reviewCount             Int              @default(0) @map("review_count")
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner            Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  listingType        ListingType         @relation(fields: [listingTypeId], references: [id])
  resource           Resource            @relation(fields: [resourceId], references: [id])
  group              ListingGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cancellationPolicy CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id], onDelete: SetNull)
  pricingRules       PricingRule[]
  availabilityRules  AvailabilityRule[]
  bookings           Booking[]
  referralLinks      ReferralLink[]
  classSessions      ClassSession[]
  listingStaff       ListingStaff[]
  reviews            Review[]
  favorites          Favorite[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([partnerId])
  @@index([resourceId])
  @@index([tenantId, provinceCode, wardCode])
  @@index([groupId])
  @@index([listingTypeId])
  @@map("listings")
}

/// Conditional pricing (§7.3) — weekday/weekend + time windows in Phase 1.
model PricingRule {
  id          String          @id @default(uuid(7)) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  listingId   String          @map("listing_id") @db.Uuid
  bookingMode BookingMode     @map("booking_mode")
  ruleType    PricingRuleType @map("rule_type")
  params      Json            @default("{}")
  /// replaces the mode's per-unit price when matched; never overrides block pricing.
  price       BigInt
  /// optional partner-funded calendar sale; must be lower than price.
  salePrice   BigInt?         @map("sale_price")
  priority    Int             @default(0)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([listingId])
  /// NOT the whole story: a UNIQUE index `pricing_rules_scope_key` on
  /// (listing_id, booking_mode, rule_type, params) also exists — one rule per scope,
  /// which is what makes "saving a scope replaces it" true under concurrency.
  /// Prisma cannot express a Json column in `@@unique`, so it lives only in the
  /// migration `20260731130000_pricing_rule_scope_unique`. Violations surface as
  /// P2002 and are translated to `PricingRuleScopeTaken` in the repository.
  @@map("pricing_rules")
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  slug      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listings        Listing[]
  commissionRules CommissionRule[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("categories")
}

// ─────────────────────────────────────────────────────────────────────────────
// 7.4 Scheduling
// ─────────────────────────────────────────────────────────────────────────────

/// Weekly recurring opening hours (§7.4). Times are local to the resource timezone.
model AvailabilityRule {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week")
  openTime  String   @map("open_time")
  closeTime String   @map("close_time")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([listingId])
  @@map("availability_rules")
}

/// Date-specific exceptions — keyed by RESOURCE so a maintenance/holiday block hits
/// every listing sharing that calendar (§7.4).
model AvailabilityException {
  id         String                    @id @default(uuid(7)) @db.Uuid
  tenantId   String                    @map("tenant_id") @db.Uuid
  resourceId String                    @map("resource_id") @db.Uuid
  date       DateTime                  @db.Date
  type       AvailabilityExceptionType
  /// `custom_hours` opening windows: `[{ openTime, closeTime }]`, resource-local HH:MM.
  /// The source of truth — a day may open, break for lunch and reopen, exactly as the
  /// weekly schedule already allows.
  windows    Json?
  /// Mirror of `windows[0]`, written on every save. Kept as a compatibility field for
  /// readers predating `windows`; never edit these directly.
  openTime   String?                   @map("open_time")
  closeTime  String?                   @map("close_time")
  reason     String?
  createdAt  DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, date])
  @@index([tenantId])
  @@index([resourceId, date])
  @@map("availability_exceptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// 7.5 Booking
// ─────────────────────────────────────────────────────────────────────────────

model Booking {
  id                         String                    @id @default(uuid(7)) @db.Uuid
  tenantId                   String                    @map("tenant_id") @db.Uuid
  listingId                  String                    @map("listing_id") @db.Uuid
  partnerId                  String                    @map("partner_id") @db.Uuid
  resourceId                 String                    @map("resource_id") @db.Uuid
  customerId                 String                    @map("customer_id") @db.Uuid
  classSessionId             String?                   @map("class_session_id") @db.Uuid
  /// short human code shown to the customer, e.g. BK-7F3K9Q — globally unique.
  code                       String                    @unique
  /// unique per tenant — retried creates return the existing booking.
  idempotencyKey             String                    @map("idempotency_key")
  bookingMode                BookingMode               @map("booking_mode")
  status                     BookingStatus             @default(draft)
  /// [start, end) UTC. Written via raw SQL (GiST exclusion constraint).
  timeslot                   Unsupported("tstzrange")?
  /// timeslot expanded by buffer, snapshotted at booking time — the exclusion key.
  blockedPeriod              Unsupported("tstzrange")? @map("blocked_period")
  guestCount                 Int                       @default(1) @map("guest_count")
  /// units rented (`inventory` mode); 1 otherwise.
  quantity                   Int                       @default(1)
  /// refundable security deposit (`inventory` mode, §9.4) — never revenue, no commission.
  securityDeposit            BigInt                    @default(0) @map("security_deposit")
  /// inventory fulfillment (§9.4): handover + return/inspection timestamps and assessed damage.
  pickedUpAt                 DateTime?                 @map("picked_up_at") @db.Timestamptz(6)
  returnedAt                 DateTime?                 @map("returned_at") @db.Timestamptz(6)
  damageAmount               BigInt                    @default(0) @map("damage_amount")
  /// overtime/surcharges added before `completed`; commissioned like an on_arrival amount.
  additionalCharges          Json                      @default("[]") @map("additional_charges")
  /// total after pricing rules, before discount.
  totalAmount                BigInt                    @map("total_amount")
  discountAmount             BigInt                    @default(0) @map("discount_amount")
  /// what the customer pays at checkout = total − discount (excludes later additional_charges).
  finalAmount                BigInt                    @map("final_amount")
  depositAmount              BigInt                    @map("deposit_amount")
  paidAmount                 BigInt                    @default(0) @map("paid_amount")
  /// Durable refund intent used by reconciliation if an outbox delivery is lost.
  refundDueAmount            BigInt?                   @map("refund_due_amount")
  refundPercent              Int?                      @map("refund_percent")
  promotionId                String?                   @map("promotion_id") @db.Uuid
  promoCode                  String?                   @map("promo_code")
  affiliateId                String?                   @map("affiliate_id") @db.Uuid
  referralCode               String?                   @map("referral_code")
  cancellationPolicyId       String?                   @map("cancellation_policy_id") @db.Uuid
  // Immutable snapshots captured at booking time (§8.2/§13.1).
  promotionSnapshot          Json?                     @map("promotion_snapshot")
  cancellationPolicySnapshot Json?                     @map("cancellation_policy_snapshot")
  pricingSnapshot            Json?                     @map("pricing_snapshot")
  listingSnapshot            Json?                     @map("listing_snapshot")
  commissionSnapshot         Json?                     @map("commission_snapshot")
  customerNote               String?                   @map("customer_note")
  partnerNote                String?                   @map("partner_note")
  /// payment/approval deadline while pending.
  expiresAt                  DateTime?                 @map("expires_at") @db.Timestamptz(6)
  createdAt                  DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listing             Listing                @relation(fields: [listingId], references: [id])
  partner             Partner                @relation(fields: [partnerId], references: [id])
  resource            Resource               @relation(fields: [resourceId], references: [id])
  customer            User                   @relation("CustomerBookings", fields: [customerId], references: [id])
  classSession        ClassSession?          @relation(fields: [classSessionId], references: [id])
  promotion           Promotion?             @relation(fields: [promotionId], references: [id])
  affiliate           Affiliate?             @relation(fields: [affiliateId], references: [id])
  cancellationPolicy  CancellationPolicy?    @relation(fields: [cancellationPolicyId], references: [id])
  payments            Payment[]
  refunds             Refund[]
  refundBatches        RefundBatch[]
  statusHistory       BookingStatusHistory[]
  promoRedemption     PromoRedemption?
  affiliateCommission AffiliateCommission?
  ledgerEntries       LedgerEntry[]
  settlement          BookingSettlement?
  settlementDisputes  SettlementDispute[]
  taxWithholdingEvents TaxWithholdingEvent[]
  review              Review?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([listingId])
  @@index([partnerId])
  @@index([resourceId])
  @@index([customerId])
  @@index([status])
  @@map("bookings")
}

/// Verified-booking customer review. Attribution is snapshotted when created so
/// later regrouping never moves historical reputation between posts.
model Review {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  bookingId  String   @unique @map("booking_id") @db.Uuid
  listingId  String   @map("listing_id") @db.Uuid
  groupId    String?  @map("group_id") @db.Uuid
  partnerId  String   @map("partner_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  rating     Int
  content    String
  /// Immutable ordered review attachments: [{ kind, key, url }].
  media      Json     @default("[]")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking  Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  listing  Listing       @relation(fields: [listingId], references: [id], onDelete: Restrict)
  group    ListingGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  partner  Partner       @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  customer User          @relation("ReviewCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  reply    ReviewReply?

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([partnerId, createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([listingId, createdAt(sort: Desc)])
  @@index([groupId, createdAt(sort: Desc)])
  @@index([tenantId, rating, createdAt(sort: Desc)])
  @@map("reviews")
}

model ReviewReply {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  reviewId     String   @unique @map("review_id") @db.Uuid
  partnerId    String   @map("partner_id") @db.Uuid
  authorUserId String   @map("author_user_id") @db.Uuid
  content      String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  review  Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  author  User    @relation("ReviewReplyAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([partnerId, createdAt(sort: Desc)])
  @@map("review_replies")
}

/// A customer's "heart" on a listing or a listing group (§16.1 wishlist). Exactly
/// one of listing_id / group_id is set (DB CHECK). partner_id is denormalised from
/// the target so the partner/tenant dashboard can scope + count without a join.
model Favorite {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  partnerId  String   @map("partner_id") @db.Uuid
  listingId  String?  @map("listing_id") @db.Uuid
  groupId    String?  @map("group_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer User          @relation("FavoriteCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  partner  Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  listing  Listing?      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  group    ListingGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([partnerId, createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([listingId])
  @@index([groupId])
  @@map("favorites")
}

/// Customer-submitted moderation signal. Target and identity labels are snapshotted
/// so a tenant can still audit a report after content or accounts are removed.
model ContentReport {
  id              String              @id @default(uuid(7)) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  reporterUserId  String?             @map("reporter_user_id") @db.Uuid
  reporterName    String              @map("reporter_name")
  partnerId       String?             @map("partner_id") @db.Uuid
  partnerName     String              @map("partner_name")
  targetType      ContentReportTarget @map("target_type")
  targetId        String              @map("target_id") @db.Uuid
  targetTitle     String              @map("target_title")
  targetSlug      String              @map("target_slug")
  reason          ContentReportReason
  details         String?
  status          ContentReportStatus @default(open)
  handledByUserId String?             @map("handled_by_user_id") @db.Uuid
  resolutionNote  String?             @map("resolution_note")
  handledAt       DateTime?           @map("handled_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reporter  User?    @relation("ContentReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  handledBy User?    @relation("ContentReportHandler", fields: [handledByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, targetType, targetId])
  @@index([reporterUserId, createdAt(sort: Desc)])
  @@map("content_reports")
}

/// A partner's edit of an already-reviewed listing or post, parked until a tenant
/// reviewer approves it (§7.3). The live row keeps serving customers meanwhile;
/// `payload` is the update input, applied verbatim through the update use-case on
/// approval. At most one `pending` row per target — enforced by a partial unique
/// index that lives in the migration (Prisma cannot express `WHERE`).
model ListingRevision {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  targetType        RevisionTarget @map("target_type")
  targetId          String         @map("target_id") @db.Uuid
  /// The edit itself, shaped like updateListingInput / updateListingGroupInput.
  payload           Json
  status            RevisionStatus @default(pending)
  submittedByUserId String?        @map("submitted_by_user_id") @db.Uuid
  submittedAt       DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedByUserId  String?        @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  /// Required when rejected — the partner reads it and fixes the change.
  reviewNote        String?        @map("review_note")
  /// Set when the payload was written onto the live row.
  appliedAt         DateTime?      @map("applied_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submittedBy User?  @relation("ListingRevisionSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewedBy  User?  @relation("ListingRevisionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, submittedAt(sort: Desc)])
  @@index([tenantId, targetType, targetId, submittedAt(sort: Desc)])
  @@map("listing_revisions")
}

/// Audit mirror of Redis holds (Redis is the source of truth) — §7.5.
model BookingHold {
  id         String                    @id @default(uuid(7)) @db.Uuid
  tenantId   String                    @map("tenant_id") @db.Uuid
  resourceId String                    @map("resource_id") @db.Uuid
  listingId  String                    @map("listing_id") @db.Uuid
  timeslot   Unsupported("tstzrange")?
  sessionId  String?                   @map("session_id")
  customerId String?                   @map("customer_id") @db.Uuid
  expiresAt  DateTime                  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@index([resourceId])
  @@map("booking_holds")
}

/// Full audit trail of every state transition (§8.2).
model BookingStatusHistory {
  id         String         @id @default(uuid(7)) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  bookingId  String         @map("booking_id") @db.Uuid
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  actorId    String?        @map("actor_id") @db.Uuid
  reason     String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bookingId])
  @@map("booking_status_history")
}

/// Tiered refund policy (§7.5): rules = [{hoursBefore, refundPercent}].
model CancellationPolicy {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// null ⇒ tenant-level shared policy; set ⇒ owned by this partner.
  partnerId String?  @map("partner_id") @db.Uuid
  name      String
  rules     Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant            Tenant    @relation("TenantPolicies", fields: [tenantId], references: [id], onDelete: Cascade)
  partner           Partner?  @relation("PartnerPolicies", fields: [partnerId], references: [id], onDelete: Cascade)
  listings          Listing[]
  bookings          Booking[]
  defaultOfTenants  Tenant[]  @relation("TenantDefaultPolicy")
  defaultOfPartners Partner[] @relation("PartnerDefaultPolicy")

  @@index([tenantId])
  @@index([partnerId])
  @@map("cancellation_policies")
}

// ─────────────────────────────────────────────────────────────────────────────
// 7.6 Payments
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id                      String                @id @default(uuid(7)) @db.Uuid
  tenantId                String                @map("tenant_id") @db.Uuid
  bookingId               String                @map("booking_id") @db.Uuid
  gateway                 PaymentGateway
  kind                    PaymentKind
  amount                  BigInt
  capturedAmount          BigInt?               @map("captured_amount")
  status                  PaymentStatus         @default(pending)
  checkoutState           PaymentCheckoutState? @map("checkout_state")
  gatewayConfigRevisionId String?               @map("gateway_config_revision_id") @db.Uuid
  refundStrategySnapshot       String?               @map("refund_strategy_snapshot")
  manualRefundSlaHoursSnapshot Int?                  @map("manual_refund_sla_hours_snapshot")
  gatewayOrderRef         String?               @map("gateway_order_ref")
  gatewayOrderId          String?               @map("gateway_order_id")
  gatewayTxnId            String?               @map("gateway_txn_id")
  paymentMethod           String?               @map("payment_method")
  gatewayPayload          Json?                 @map("gateway_payload")
  idempotencyKey          String                @unique @map("idempotency_key")
  paidAt                  DateTime?             @map("paid_at") @db.Timestamptz(6)
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking               Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  gatewayConfigRevision TenantGatewayConfig? @relation(fields: [gatewayConfigRevisionId], references: [id], onDelete: Restrict)
  refunds               Refund[]
  ledgerEntries         LedgerEntry[]
  settlement            BookingSettlement?

  @@unique([gateway, gatewayTxnId])
  @@unique([gateway, gatewayOrderRef])
  @@index([tenantId])
  @@index([bookingId])
  @@index([gatewayConfigRevisionId])
  @@map("payments")
}

model Refund {
  id                   String              @id @default(uuid(7)) @db.Uuid
  tenantId             String              @map("tenant_id") @db.Uuid
  refundBatchId        String?             @map("refund_batch_id") @db.Uuid
  paymentId            String              @map("payment_id") @db.Uuid
  bookingId            String              @map("booking_id") @db.Uuid
  amount               BigInt
  status               RefundStatus        @default(pending)
  reason               String?
  affectsBookingStatus Boolean             @default(true) @map("affects_booking_status")
  gatewayRefundId      String?             @map("gateway_refund_id")
  executionMode        RefundExecutionMode @default(manual) @map("execution_mode")
  dueAt                DateTime?           @map("due_at") @db.Timestamptz(6)
  completedAt          DateTime?           @map("completed_at") @db.Timestamptz(6)
  evidence             Json?
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refundBatch RefundBatch? @relation(fields: [refundBatchId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([paymentId])
  @@index([bookingId])
  @@index([refundBatchId])
  @@index([bookingId, reason])
  @@map("refunds")
}

model RefundBatch {
  id                   String            @id @default(uuid(7)) @db.Uuid
  tenantId             String            @map("tenant_id") @db.Uuid
  bookingId            String            @map("booking_id") @db.Uuid
  requestedAmount      BigInt            @map("requested_amount")
  reason               String
  affectsBookingStatus Boolean           @default(true) @map("affects_booking_status")
  status               RefundBatchStatus @default(processing)
  completedAt          DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refunds Refund[]
  manualRefundOperation ManualRefundOperation?

  @@unique([tenantId, bookingId, reason])
  @@index([tenantId, status, updatedAt])
  @@map("refund_batches")
}

/// Provider-neutral, maker-checker manual refund workflow. One operation owns
/// the customer destination and transfer evidence for the entire RefundBatch.
model ManualRefundOperation {
  id                              String                               @id @default(uuid(7)) @db.Uuid
  tenantId                        String                               @map("tenant_id") @db.Uuid
  refundBatchId                   String                               @unique @map("refund_batch_id") @db.Uuid
  status                          ManualRefundOperationStatus          @default(awaiting_details)
  version                         Int                                  @default(1)
  destinationBankCode             String?                              @map("destination_bank_code")
  destinationAccountName          String?                              @map("destination_account_name")
  destinationAccountLast4         String?                              @map("destination_account_last4")
  destinationAccountCiphertext    String?                              @map("destination_account_ciphertext")
  destinationEncryptionKeyVersion String?                              @map("destination_encryption_key_version")
  destinationAccountFingerprint   String?                              @map("destination_account_fingerprint")
  destinationIsThirdParty         Boolean                              @default(false) @map("destination_is_third_party")
  destinationConsentAt            DateTime?                            @map("destination_consent_at") @db.Timestamptz(6)
  destinationSubmittedAt          DateTime?                            @map("destination_submitted_at") @db.Timestamptz(6)
  verificationResult              String?                              @map("verification_result")
  verificationMethod              String?                              @map("verification_method")
  verifiedByUserId                String?                              @map("verified_by_user_id") @db.Uuid
  verifiedAt                      DateTime?                            @map("verified_at") @db.Timestamptz(6)
  makerUserId                     String?                              @map("maker_user_id") @db.Uuid
  claimedAt                       DateTime?                            @map("claimed_at") @db.Timestamptz(6)
  transferReference               String?                              @map("transfer_reference")
  transferReferenceNormalized     String?                              @map("transfer_reference_normalized")
  evidenceObjectKey               String?                              @map("evidence_object_key")
  evidenceContentType             String?                              @map("evidence_content_type")
  evidenceSizeBytes               Int?                                 @map("evidence_size_bytes")
  evidenceSha256                  String?                              @map("evidence_sha256")
  evidenceVerifiedAt              DateTime?                            @map("evidence_verified_at") @db.Timestamptz(6)
  transferSubmittedByUserId       String?                              @map("transfer_submitted_by_user_id") @db.Uuid
  transferSubmittedAt             DateTime?                            @map("transfer_submitted_at") @db.Timestamptz(6)
  checkedByUserId                 String?                              @map("checked_by_user_id") @db.Uuid
  checkedAt                       DateTime?                            @map("checked_at") @db.Timestamptz(6)
  rejectionReason                 String?                              @map("rejection_reason")
  readyAt                         DateTime?                            @map("ready_at") @db.Timestamptz(6)
  transferDueAt                   DateTime?                            @map("transfer_due_at") @db.Timestamptz(6)
  completedAt                     DateTime?                            @map("completed_at") @db.Timestamptz(6)
  customerAcknowledgement         ManualRefundCustomerAcknowledgement? @map("customer_acknowledgement")
  customerAcknowledgedAt          DateTime?                            @map("customer_acknowledged_at") @db.Timestamptz(6)
  customerAcknowledgementNote     String?                              @map("customer_acknowledgement_note")
  ciphertextPurgedAt              DateTime?                            @map("ciphertext_purged_at") @db.Timestamptz(6)
  breakGlassByUserId              String?                              @map("break_glass_by_user_id") @db.Uuid
  breakGlassReason                String?                              @map("break_glass_reason")
  breakGlassAt                    DateTime?                            @map("break_glass_at") @db.Timestamptz(6)
  createdAt                       DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                       DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refundBatch RefundBatch @relation(fields: [refundBatchId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, updatedAt])
  @@index([tenantId, makerUserId, status])
  @@index([tenantId, transferDueAt])
  @@map("manual_refund_operations")
}

/// Per-tenant gateway credentials — credentials jsonb is AES-256-GCM encrypted at
/// the app layer, never returned by the API (§7.6/§20).

model TenantPaymentMethodRoute {
  id        String         @id @default(uuid(7)) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  method    String
  gateway   PaymentGateway
  enabled   Boolean        @default(true)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, method])
  @@index([tenantId, gateway])
  @@map("tenant_payment_method_routes")
}

model TenantRefundPolicy {
  tenantId             String   @id @map("tenant_id") @db.Uuid
  refundStrategy       String   @map("refund_strategy")
  manualRefundSlaHours Int      @map("manual_refund_sla_hours")
  updatedBy            String?  @map("updated_by") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_refund_policies")
}

model TenantGatewayConfig {
  id          String             @id @default(uuid(7)) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  gateway     PaymentGateway
  credentials Json               @default("{}")
  /// Non-secret checkout/refund policy. Validated by @booking/contracts.
  settings    Json               @default("{\"enabledMethods\":[\"bank_transfer\"],\"refundStrategy\":\"manual\",\"manualRefundSlaHours\":72}")
  isActive    Boolean            @default(true) @map("is_active")
  environment GatewayEnvironment @default(sandbox)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([tenantId])
  @@index([tenantId, gateway, environment])
  @@map("tenant_gateway_configs")
}

// ─────────────────────────────────────────────────────────────────────────────
// 7.7 Finance
// ─────────────────────────────────────────────────────────────────────────────

model CommissionRule {
  id                String              @id @default(uuid(7)) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  appliesTo         CommissionAppliesTo @map("applies_to")
  listingTypeId     String?             @map("listing_type_id") @db.Uuid
  categoryId        String?             @map("category_id") @db.Uuid
  partnerId         String?             @map("partner_id") @db.Uuid
  tenantRateType    RateType            @default(percent) @map("tenant_rate_type")
  /// percent = basis points or 0–100; fixed = VND. See §18 rounding.
  tenantRate        BigInt              @map("tenant_rate")
  /// platform fee %, editable only by the platform admin.
  platformRate      Int                 @default(0) @map("platform_rate")
  affiliateRateType RateType            @default(percent) @map("affiliate_rate_type")
  affiliateRate     BigInt              @default(0) @map("affiliate_rate")
  effectiveFrom     DateTime?           @map("effective_from") @db.Timestamptz(6)
  effectiveTo       DateTime?           @map("effective_to") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listingType ListingType? @relation(fields: [listingTypeId], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  partner     Partner?     @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("commission_rules")
}

/// One account per party per tenant (§7.7). owner is polymorphic (owner_type + owner_id).
model LedgerAccount {
  id        String          @id @default(uuid(7)) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  ownerType LedgerOwnerType @map("owner_type")
  ownerId   String?         @map("owner_id") @db.Uuid
  currency  String          @default("VND")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]

  @@unique([tenantId, ownerType, ownerId])
  @@index([tenantId])
  @@map("ledger_accounts")
}

/// Double-entry, immutable (append-only — enforced by a trigger in the SQL migration).
/// A business transaction groups its lines by journal_id; sum(debit) = sum(credit).
model LedgerEntry {
  id          String          @id @default(uuid(7)) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  journalId   String          @map("journal_id") @db.Uuid
  accountId   String          @map("account_id") @db.Uuid
  entryType   LedgerEntryType @map("entry_type")
  debit       BigInt          @default(0)
  credit      BigInt          @default(0)
  bookingId   String?         @map("booking_id") @db.Uuid
  paymentId   String?         @map("payment_id") @db.Uuid
  payoutId    String?         @map("payout_id") @db.Uuid
  memo        String?
  /// Explicit payout maturity; do not infer eligibility from created_at.
  availableAt DateTime        @default(now()) @map("available_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  account LedgerAccount @relation(fields: [accountId], references: [id])
  booking Booking?      @relation(fields: [bookingId], references: [id])
  payment Payment?      @relation(fields: [paymentId], references: [id])
  payout  Payout?       @relation(fields: [payoutId], references: [id])

  @@index([tenantId])
  @@index([journalId])
  @@index([accountId])
  @@index([bookingId])
  @@index([accountId, availableAt])
  @@map("ledger_entries")
}

model Payout {
  id         String          @id @default(uuid(7)) @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  payeeType  PayoutPayeeType @map("payee_type")
  payeeId    String          @map("payee_id") @db.Uuid
  amount     BigInt
  periodFrom DateTime?       @map("period_from") @db.Timestamptz(6)
  periodTo   DateTime?       @map("period_to") @db.Timestamptz(6)
  status     PayoutStatus    @default(pending)
  paidAt     DateTime?       @map("paid_at") @db.Timestamptz(6)
  /// transfer reference number + evidence file key.
  evidence   Json?
  createdBy  String?         @map("created_by") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]
  allocations   PayoutAllocation[]

  @@index([tenantId])
  @@index([payeeType, payeeId])
  @@map("payouts")
}

/// Tenant-custodied customer funds. Provider success creates `held`; service
/// completion opens the dispute window; only release creates earnings/payables.
model BookingSettlement {
  id                    String           @id @default(uuid(7)) @db.Uuid
  tenantId              String           @map("tenant_id") @db.Uuid
  bookingId             String           @unique @map("booking_id") @db.Uuid
  paymentId             String           @unique @map("payment_id") @db.Uuid
  partnerId             String           @map("partner_id") @db.Uuid
  status                SettlementStatus @default(held)
  kind                  SettlementKind   @default(service_completed)
  onlineHeldAmount      BigInt           @map("online_held_amount")
  onsiteCollectedAmount BigInt           @default(0) @map("onsite_collected_amount")
  securityDepositHeld   BigInt           @default(0) @map("security_deposit_held")
  tenantCommissionGross BigInt           @default(0) @map("tenant_commission_gross")
  tenantNetEarning      BigInt           @default(0) @map("tenant_net_earning")
  partnerGrossEarning   BigInt           @default(0) @map("partner_gross_earning")
  partnerPayable        BigInt           @default(0) @map("partner_payable")
  /// Withheld from the partner and remitted by the tenant (§NĐ117). Kept
  /// separately so payout statements can explain the smaller payable.
  partnerVatWithheld    BigInt           @default(0) @map("partner_vat_withheld")
  partnerPitWithheld    BigInt           @default(0) @map("partner_pit_withheld")
  platformFee           BigInt           @default(0) @map("platform_fee")
  affiliateCommission   BigInt           @default(0) @map("affiliate_commission")
  refundedAmount        BigInt           @default(0) @map("refunded_amount")
  retainedAmount        BigInt           @default(0) @map("retained_amount")
  refundId              String?          @unique @map("refund_id") @db.Uuid
  completedAt           DateTime?        @map("completed_at") @db.Timestamptz(6)
  disputeUntil          DateTime?        @map("dispute_until") @db.Timestamptz(6)
  releasedAt            DateTime?        @map("released_at") @db.Timestamptz(6)
  releaseJournalId      String?          @map("release_journal_id") @db.Uuid
  withholdingJournalId  String?          @unique @map("withholding_journal_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking           Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment           Payment            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  partner           Partner            @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  // Business refund reference: legacy Refund.id or batched RefundBatch.id.
  // The database column is intentionally polymorphic and has no single-table FK.
  dispute           SettlementDispute?
  payoutAllocations PayoutAllocation[]
  taxWithholdingEvents TaxWithholdingEvent[]

  @@index([tenantId])
  @@index([partnerId, status])
  @@index([status, disputeUntil])
  @@map("booking_settlements")
}

/// Append-only assessment/reversal facts. Confirmed service completion (the
/// accepted transaction) creates the withholding event; a confirmed refund creates
/// a linked reversal. Settlement release and payout create no tax fact at all.
/// `occurred_at` is the transaction month, never the month a payout cleared.
model TaxWithholdingEvent {
  id                 String                  @id @default(uuid(7)) @db.Uuid
  tenantId           String                  @map("tenant_id") @db.Uuid
  settlementId       String                  @map("settlement_id") @db.Uuid
  bookingId          String                  @map("booking_id") @db.Uuid
  partnerId          String                  @map("partner_id") @db.Uuid
  eventType          TaxWithholdingEventType @map("event_type")
  sourceKey          String                  @map("source_key")
  originalEventId    String?                 @map("original_event_id") @db.Uuid
  taxableRevenue     BigInt                  @map("taxable_revenue")
  vatAmount          BigInt                  @map("vat_amount")
  pitAmount          BigInt                  @map("pit_amount")
  journalId          String                  @map("journal_id") @db.Uuid
  occurredAt         DateTime                @map("occurred_at") @db.Timestamptz(6)
  filingPeriodId     String?                 @map("filing_period_id") @db.Uuid
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settlement      BookingSettlement         @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  booking         Booking                   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  partner         Partner                   @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  originalEvent   TaxWithholdingEvent?       @relation("TaxWithholdingReversals", fields: [originalEventId], references: [id], onDelete: Restrict)
  reversalEvents  TaxWithholdingEvent[]      @relation("TaxWithholdingReversals")
  filingPeriod    TaxFilingPeriod?           @relation(fields: [filingPeriodId], references: [id], onDelete: Restrict)

  @@unique([tenantId, sourceKey])
  @@index([tenantId, occurredAt])
  @@index([partnerId, occurredAt])
  @@index([filingPeriodId])
  @@map("tax_withholding_events")
}

/// One immutable preparation boundary per Vietnamese calendar month. Events
/// are assigned once; late reversals enter the month in which they occur.
model TaxFilingPeriod {
  id                    String          @id @default(uuid(7)) @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  taxYear               Int             @map("tax_year")
  taxMonth              Int             @map("tax_month")
  status                TaxFilingStatus @default(draft)
  taxableRevenue        BigInt          @default(0) @map("taxable_revenue")
  vatAmount             BigInt          @default(0) @map("vat_amount")
  pitAmount             BigInt          @default(0) @map("pit_amount")
  preparedBy            String          @map("prepared_by") @db.Uuid
  submittedBy           String?         @map("submitted_by") @db.Uuid
  submissionReference   String?         @map("submission_reference")
  submittedAt           DateTime?       @map("submitted_at") @db.Timestamptz(6)
  paidAt                DateTime?       @map("paid_at") @db.Timestamptz(6)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events       TaxWithholdingEvent[]
  remittances  TaxRemittance[]

  @@unique([tenantId, taxYear, taxMonth])
  @@index([tenantId, status])
  @@map("tax_filing_periods")
}

model TaxRemittance {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  filingPeriodId   String   @map("filing_period_id") @db.Uuid
  vatAmount        BigInt   @map("vat_amount")
  pitAmount        BigInt   @map("pit_amount")
  paymentReference String   @map("payment_reference")
  evidence         Json?
  journalId        String   @unique @map("journal_id") @db.Uuid
  paidAt           DateTime @map("paid_at") @db.Timestamptz(6)
  recordedBy       String   @map("recorded_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  filingPeriod TaxFilingPeriod @relation(fields: [filingPeriodId], references: [id], onDelete: Restrict)

  @@unique([tenantId, filingPeriodId, paymentReference])
  @@index([tenantId, paidAt])
  @@map("tax_remittances")
}

/// Annual electronic certificate metadata. The signed artifact remains in the
/// configured object store; replacement creates a new checksum/file key.
model TaxWithholdingCertificate {
  id                String               @id @default(uuid(7)) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  partnerId         String               @map("partner_id") @db.Uuid
  taxYear           Int                  @map("tax_year")
  status            TaxCertificateStatus @default(draft)
  version           Int                  @default(1)
  certificateNumber String?              @map("certificate_number")
  vatAmount         BigInt               @default(0) @map("vat_amount")
  pitAmount         BigInt               @default(0) @map("pit_amount")
  fileKey           String?              @map("file_key")
  checksum          String?
  issuedAt          DateTime?            @map("issued_at") @db.Timestamptz(6)
  issuedBy          String?              @map("issued_by") @db.Uuid
  supersedesId      String?              @map("supersedes_id") @db.Uuid
  documentUploadId  String?              @unique @map("document_upload_id") @db.Uuid
  voidedAt          DateTime?            @map("voided_at") @db.Timestamptz(6)
  voidedBy          String?              @map("voided_by") @db.Uuid
  voidReason        String?              @map("void_reason")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner        Partner                     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  supersedes     TaxWithholdingCertificate?  @relation("TaxCertificateVersions", fields: [supersedesId], references: [id], onDelete: Restrict)
  reissues       TaxWithholdingCertificate[] @relation("TaxCertificateVersions")
  documentUpload TaxDocumentUpload?          @relation(fields: [documentUploadId], references: [id], onDelete: Restrict)

  @@unique([tenantId, partnerId, taxYear, version])
  @@index([tenantId, taxYear, status])
  @@map("tax_withholding_certificates")
}

/// A private PDF upload grant. The pending row is the server-side trust anchor for
/// the browser upload; issuance recomputes the bytes' SHA-256 before attaching it.
model TaxDocumentUpload {
  id           String                  @id @default(uuid(7)) @db.Uuid
  tenantId     String                  @map("tenant_id") @db.Uuid
  objectKey    String                  @map("object_key")
  checksum     String                  @db.Char(64)
  sizeBytes    Int                     @map("size_bytes")
  contentType  String                  @map("content_type")
  status       TaxDocumentUploadStatus @default(pending)
  expiresAt    DateTime                @map("expires_at") @db.Timestamptz(6)
  attachedAt   DateTime?               @map("attached_at") @db.Timestamptz(6)
  deletedAt    DateTime?               @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  certificate TaxWithholdingCertificate?

  @@unique([tenantId, objectKey])
  @@index([tenantId, status, expiresAt])
  @@map("tax_document_uploads")
}

model SettlementDispute {
  id                 String                       @id @default(uuid(7)) @db.Uuid
  tenantId           String                       @map("tenant_id") @db.Uuid
  settlementId       String                       @unique @map("settlement_id") @db.Uuid
  bookingId          String                       @map("booking_id") @db.Uuid
  openedByUserId     String                       @map("opened_by_user_id") @db.Uuid
  openedByRole       String                       @map("opened_by_role")
  reason             String
  evidence           Json                         @default("[]")
  partnerResponse    String?                      @map("partner_response")
  partnerRespondedBy String?                      @map("partner_responded_by") @db.Uuid
  partnerRespondedAt DateTime?                    @map("partner_responded_at") @db.Timestamptz(6)
  status             SettlementDisputeStatus      @default(open)
  resolution         SettlementDisputeResolution?
  resolutionNote     String?                      @map("resolution_note")
  refundAmount       BigInt                       @default(0) @map("refund_amount")
  resolvedBy         String?                      @map("resolved_by") @db.Uuid
  resolvedAt         DateTime?                    @map("resolved_at") @db.Timestamptz(6)
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settlement BookingSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  booking    Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([bookingId])
  @@map("settlement_disputes")
}

model PayoutAllocation {
  id           String                 @id @default(uuid(7)) @db.Uuid
  tenantId     String                 @map("tenant_id") @db.Uuid
  payoutId     String                 @map("payout_id") @db.Uuid
  settlementId String                 @map("settlement_id") @db.Uuid
  amount       BigInt
  status       PayoutAllocationStatus @default(reserved)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payout     Payout            @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  settlement BookingSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  @@unique([payoutId, settlementId])
  @@index([tenantId])
  @@index([settlementId, status])
  @@map("payout_allocations")
}

// ─────────────────────────────────────────────────────────────────────────────
// 7.9 Promotions
// ─────────────────────────────────────────────────────────────────────────────

model Promotion {
  id                    String                @id @default(uuid(7)) @db.Uuid
  tenantId              String                @map("tenant_id") @db.Uuid
  name                  String
  /// entered by the customer, uppercase, unique within tenant; null = auto-campaign (Phase 2).
  code                  String?
  discountType          PromotionDiscountType @map("discount_type")
  discountValue         BigInt                @map("discount_value")
  /// cap on the discount for a `percent` type.
  maxDiscount           BigInt?               @map("max_discount")
  fundedBy              PromotionFundedBy     @default(tenant) @map("funded_by")
  appliesTo             PromotionAppliesTo    @default(all) @map("applies_to")
  /// the target id matching applies_to (listing/type/category/partner/group).
  appliesToId           String?               @map("applies_to_id") @db.Uuid
  minOrderAmount        BigInt?                @map("min_order_amount")
  firstBookingOnly      Boolean               @default(false) @map("first_booking_only")
  usageLimitTotal       Int?                  @map("usage_limit_total")
  usageLimitPerCustomer Int?                  @map("usage_limit_per_customer")
  /// atomically incremented; race-safe (§12.3).
  redeemedCount         Int                   @default(0) @map("redeemed_count")
  startsAt              DateTime?             @map("starts_at") @db.Timestamptz(6)
  endsAt                DateTime?             @map("ends_at") @db.Timestamptz(6)
  status                PromotionStatus       @default(draft)
  createdByPartnerId    String?               @map("created_by_partner_id") @db.Uuid
  /// off-peak windows: `[{ days:[6,0], from:"18:00", to:"22:00" }]` (§12.1 Phase 2). null = always.
  timeWindows           Json?                 @map("time_windows")
  /// the partner bearing the cost for a `funded_by = partner` promo (resolved from scope, §12.2).
  fundingPartnerId      String?               @map("funding_partner_id") @db.Uuid
  /// gate for a tenant-created partner-funded promo: null = pending the partner's opt-in (§12.2).
  partnerOptInAt        DateTime?             @map("partner_opt_in_at") @db.Timestamptz(6)
  /// Whether a customer-entered code may be discovered in the storefront checkout picker.
  storefrontVisible     Boolean               @default(false) @map("storefront_visible")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByPartner Partner?          @relation("PartnerCreatedPromotions", fields: [createdByPartnerId], references: [id], onDelete: SetNull)
  fundingPartner   Partner?          @relation("PartnerFundedPromotions", fields: [fundingPartnerId], references: [id], onDelete: SetNull)
  redemptions      PromoRedemption[]
  bookings         Booking[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([fundingPartnerId])
  @@map("promotions")
}

/// Each use of a code, tied 1:1 to a booking (§7.9).
model PromoRedemption {
  id             String                @id @default(uuid(7)) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  promotionId    String                @map("promotion_id") @db.Uuid
  bookingId      String                @unique @map("booking_id") @db.Uuid
  customerId     String                @map("customer_id") @db.Uuid
  discountAmount BigInt                @map("discount_amount")
  status         PromoRedemptionStatus @default(reserved)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([promotionId])
  @@index([promotionId, customerId])
  @@map("promo_redemptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// 7.8 Affiliate (Phase 2)
// ─────────────────────────────────────────────────────────────────────────────

model Affiliate {
  id         String          @id @default(uuid(7)) @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  status     AffiliateStatus @default(pending)
  /// overrides the applicable commission rule's affiliate rate.
  customRate BigInt?         @map("custom_rate")
  payoutInfo Json            @default("{}") @map("payout_info")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralLinks ReferralLink[]
  commissions   AffiliateCommission[]
  bookings      Booking[]

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("affiliates")
}

model ReferralLink {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  affiliateId String         @map("affiliate_id") @db.Uuid
  code        String
  target      ReferralTarget @default(tenant_home)
  listingId   String?        @map("listing_id") @db.Uuid
  clicksCount Int            @default(0) @map("clicks_count")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  affiliate Affiliate       @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  listing   Listing?        @relation(fields: [listingId], references: [id], onDelete: SetNull)
  clicks    ReferralClick[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([affiliateId])
  @@map("referral_links")
}

model ReferralClick {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  referralLinkId String   @map("referral_link_id") @db.Uuid
  visitorId      String?  @map("visitor_id")
  ipHash         String?  @map("ip_hash")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  referralLink ReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([referralLinkId])
  @@map("referral_clicks")
}

model AffiliateCommission {
  id          String                    @id @default(uuid(7)) @db.Uuid
  tenantId    String                    @map("tenant_id") @db.Uuid
  affiliateId String                    @map("affiliate_id") @db.Uuid
  bookingId   String                    @unique @map("booking_id") @db.Uuid
  amount      BigInt
  status      AffiliateCommissionStatus @default(pending)
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([affiliateId])
  @@map("affiliate_commissions")
}

// ─────────────────────────────────────────────────────────────────────────────
// 7.3 Catalog — appointment/class support (Phase 3, modelled from day one §9.3/§9.5)
// ─────────────────────────────────────────────────────────────────────────────

model Staff {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  partnerId   String   @map("partner_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  displayName String   @map("display_name")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  partner      Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  availability StaffAvailability[]
  listingStaff ListingStaff[]

  @@index([tenantId])
  @@index([partnerId])
  @@map("staff")
}

model StaffAvailability {
  id        String @id @default(uuid(7)) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  staffId   String @map("staff_id") @db.Uuid
  dayOfWeek Int    @map("day_of_week")
  openTime  String @map("open_time")
  closeTime String @map("close_time")

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([staffId])
  @@map("staff_availability")
}

model ListingStaff {
  tenantId        String @map("tenant_id") @db.Uuid
  listingId       String @map("listing_id") @db.Uuid
  staffId         String @map("staff_id") @db.Uuid
  serviceDuration Int?   @map("service_duration")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([listingId, staffId])
  @@index([tenantId])
  @@map("listing_staff")
}

model ClassSession {
  id          String             @id @default(uuid(7)) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  listingId   String             @map("listing_id") @db.Uuid
  startsAt    DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime           @map("ends_at") @db.Timestamptz(6)
  capacity    Int
  bookedCount Int                @default(0) @map("booked_count")
  status      ClassSessionStatus @default(scheduled)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([tenantId])
  @@index([listingId])
  @@map("class_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// 7.10 Infrastructure
// ─────────────────────────────────────────────────────────────────────────────

model OutboxEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String?   @map("tenant_id") @db.Uuid
  aggregateType  String?   @map("aggregate_type")
  aggregateId    String?   @map("aggregate_id") @db.Uuid
  eventType      String    @map("event_type")
  payload        Json
  attempts       Int       @default(0)
  // dbgenerated: the DB clock must own this value — a client-side now() can
  // run ahead of Postgres and make fresh events invisible to the relay's
  // `available_at <= now()` claim query
  availableAt    DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("available_at") @db.Timestamptz(6)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(6)
  deadLetteredAt DateTime? @map("dead_lettered_at") @db.Timestamptz(6)
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([processedAt, availableAt])
  @@map("outbox_events")
}

model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  data        Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// What was sent per notification event (§17).
model NotificationLog {
  id        String              @id @default(uuid(7)) @db.Uuid
  tenantId  String?             @map("tenant_id") @db.Uuid
  userId    String?             @map("user_id") @db.Uuid
  channel   NotificationChannel
  eventType String              @map("event_type")
  dedupeKey String?             @map("dedupe_key")
  recipient String?
  status    NotificationStatus  @default(pending)
  payload   Json?
  error     String?
  sentAt    DateTime?           @map("sent_at") @db.Timestamptz(6)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@index([userId])
  @@map("notification_logs")
}

/// In-app notification inbox. RLS isolates TENANTS, not users: inside one
/// tenant an app_user session can read every row. Per-user isolation lives
/// entirely in the repository's `WHERE user_id = $me` — never remove it.
model Notification {
  id         String           @id @default(uuid(7)) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  area       NotificationArea
  eventType  String           @map("event_type")
  title      String
  body       String?
  targetType String           @map("target_type")
  targetId   String?          @map("target_id") @db.Uuid
  dedupeKey  String           @map("dedupe_key")
  readAt     DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, dedupeKey])
  @@index([userId, tenantId, area, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("notifications")
}
