// Full data model (TONG-QUAN.md §7) — the single source of truth.
//
// Anything Prisma cannot express lives in hand-written SQL migrations
// (prisma/migrations/*):
//   - RLS policies + FORCE ROW LEVEL SECURITY per tenant table (§6.2)
//   - app_user / app_admin database roles (§6.3)
//   - the tstzrange GiST EXCLUDE constraint against double-booking (§10)
//   - NULLS NOT DISTINCT unique indexes
//   - the ledger deferred debit=credit balancing trigger (§13)
//   - append-only (no UPDATE/DELETE) guard on ledger_entries
//
// Conventions (§7 header):
//   - PK: uuid v7. Money: BigInt (VND, no decimals). Time: timestamptz UTC.
//   - Every tenant-scoped table carries `tenant_id`. Top-level aggregates
//     declare a Prisma relation back to Tenant; deep child tables keep
//     `tenant_id` as a plain indexed RLS column (their FK to the aggregate
//     already cascades the tenant), so `check:rls` still sees the column.
//   - tstzrange columns (timeslot, blocked_period) are Unsupported() — bookings
//     are written via raw SQL so the GiST exclusion constraint applies.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("MIGRATE_DATABASE_URL")
  extensions = [citext, pgcrypto, btree_gist]
}

