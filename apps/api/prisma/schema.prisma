  @@map("partner_type")
}

/// VAT treatment of a listing type (§VAT). The tenant picks the CATEGORY; the
/// platform owns the rate that category maps to at a given date (`tax_rates`).
/// VAT treatment. The first four are DEDUCTION-method categories a tenant picks
/// for a listing type; `percentage_service` belongs to the tỷ-lệ-%-trên-doanh-thu
/// method and is never chosen by a tenant — it is selected by WHO sells, because
/// a household on that method has one rate whatever it sells.
enum TaxCategory {
  standard
  reduced_5
  exempt
  not_taxable
  percentage_service

  @@map("tax_category")
}

/// Whether a seller charges output VAT. `household_below_threshold` is the
/// annual-revenue exemption (1B VND from 2026 under NĐ 141/2026/NĐ-CP);
/// `individual` is a
/// non-business person. Both resolve to a 0% rate whatever the listing type.
enum PartnerTaxStatus {
  company_vat
  household_declaring
  household_below_threshold
  individual

  @@map("partner_tax_status")
}

enum PartnerTaxAssessmentStatus {
  missing_declaration
