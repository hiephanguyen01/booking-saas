{
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1083.0",
    "@aws-sdk/s3-request-presigner": "^3.1083.0",
    "@booking/contracts": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.11.0",
    "argon2": "^0.43.0",
    "bullmq": "^5.56.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "nestjs-pino": "^4.4.0",
    "nestjs-zod": "^5.4.0",
    "nodemailer": "^9.0.3",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "prisma": "^6.11.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-email": "^6.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sepay-pg-node": "^1.0.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@swc/core": "^1.12.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^20.19.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "unplugin-swc": "^1.5.5",
    "vitest": "^3.2.0"
  },
  "name": "@booking/api",
  "private": true,
  "scripts": {
    "build": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js generate && tsc -p tsconfig.build.json && tsc -p tsconfig.operations.json",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js generate && tsc --noEmit",
    "dev": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js generate && node --env-file-if-exists=../../.env ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:dev": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js generate && node --env-file-if-exists=../../.env ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "prisma:generate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js generate",
    "prisma:reset": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate reset",
    "prisma:studio": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js studio",
    "prisma:deploy": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate deploy",
    "seed": "pnpm --filter=@booking/contracts build && node --env-file-if-exists=../../.env ./node_modules/ts-node/dist/bin.js --transpile-only prisma/seed.ts",
    "quick:start": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate reset && node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js generate && node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate deploy && pnpm run seed",
    "storage:init": "node --env-file-if-exists=../../.env ./node_modules/ts-node/dist/bin.js --transpile-only scripts/bootstrap-storage.ts",
    "audit:tax": "node --env-file-if-exists=../../.env ./node_modules/ts-node/dist/bin.js --transpile-only scripts/audit-tax-lifecycle.ts",
    "verify:tax": "node --env-file-if-exists=../../.env ./node_modules/ts-node/dist/bin.js --transpile-only scripts/verify-tax-scenarios.ts"
  },
  "version": "0.0.1"
}
