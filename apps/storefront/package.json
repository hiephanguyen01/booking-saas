{
  "name": "@booking/storefront",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env ./node_modules/@react-router/dev/bin.cjs dev",
    "build": "node --env-file-if-exists=../../.env ./node_modules/@react-router/dev/bin.cjs build",
    "start": "node --env-file-if-exists=../../.env ./node_modules/@react-router/serve/bin.cjs ./build/server/index.js",
    "lint": "eslint app",
    "typecheck": "node --env-file-if-exists=../../.env ./node_modules/@react-router/dev/bin.cjs typegen && tsc"
  },
  "dependencies": {
    "@booking/api-client": "workspace:*",
    "@booking/contracts": "workspace:*",
    "@booking/i18n": "workspace:*",
    "@booking/ui": "workspace:*",
    "@react-router/node": "8.0.1",
    "@react-router/serve": "8.0.1",
    "@hookform/resolvers": "^5.2.0",
    "isbot": "^5.1.0",
    "lucide-react": "^0.400.0",
    "react-hook-form": "^7.60.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.0.1",
    "redis": "6.1.0",
    "simple-icons": "^16.27.1",
    "swiper": "^11.2.10",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0"
  }
}
