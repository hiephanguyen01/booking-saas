# Rendered by the nginx image's envsubst entrypoint from ${DASHBOARD_HOST} and
# ${API_HOST} (see docker-compose.deploy.yml). TLS terminates in front of this.
#
# Docker may assign a different container IP after a restart. Using its embedded
# DNS resolver together with variable-based proxy targets makes nginx re-resolve
# service names instead of pinning the IPs it saw when nginx started.
resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 5s;

# Uploads go browser → storage directly via a presigned URL, so nothing large
# passes through here except the presign request itself.
client_max_body_size 2m;

proxy_http_version 1.1;
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
proxy_set_header Connection        '';
proxy_buffering off;

server {
  listen 80;
  server_name ${DASHBOARD_HOST};
  set $dashboard_target dashboard:3000;
  location / { proxy_pass http://$dashboard_target; }
}

server {
  listen 80;
  server_name ${API_HOST};
  set $api_target api:3000;
  location / { proxy_pass http://$api_target; }
}

# DEFAULT SERVER — deliberately last and catch-all.
#
# The storefront resolves its tenant from the Host header against
# `tenant_domains`, so a brand-new custom domain must reach it WITHOUT an nginx
# change. Naming hosts here instead would mean every tenant onboarding needs a
# deploy.
server {
  listen 80 default_server;
  server_name _;
  set $storefront_target storefront:3000;
  location / { proxy_pass http://$storefront_target; }
}
