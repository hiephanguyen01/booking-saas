# BookingOS — TLS terminator. Runs as the `caddy` service in
# docker-compose.deploy.yml (profile `tls`), NOT as a host systemd unit.
#
# IN COMPOSE ON PURPOSE. The Deploy workflow syncs this file to the box and
# recreates the container, so a change here ships like any other change. A host
# systemd unit would put the config at /etc/caddy/Caddyfile — outside DEPLOY_PATH,
# needing sudo — and every edit would be a manual scp somebody eventually forgets.
#
# EVERY hostname is an env var read from the same .env.<env> as the rest of the
# stack, so this one file serves staging and production unchanged:
#
#   ACME_EMAIL   real operated mailbox — Let's Encrypt sends expiry warnings here
#   DASHBOARD_HOST / API_HOST   admin.stg.bookingos.vn / api.stg.bookingos.vn
#
# Validate against the version compose actually runs before shipping — on-demand
# syntax has moved between Caddy 2.x releases (the old rate-limit options were
# removed):
#
#   docker compose --env-file .env.stg -f docker-compose.deploy.yml \
#     run --rm --entrypoint caddy caddy validate --config /etc/caddy/Caddyfile
#
# WHY CADDY: a tenant custom domain (booking.giangstudio.vn) can be added at any
# moment through the dashboard. Terminating TLS with a fixed Let's Encrypt
# certificate means every such domain fails at the TLS handshake — the browser
# reports the wrong certificate and the request never reaches the app. On-demand
# TLS obtains a certificate at the first handshake for a hostname, with no ops
# step and no redeploy per tenant.
{
	email {$ACME_EMAIL}

	on_demand_tls {
		# THE gate. Caddy blocks the TLS handshake on this call and only obtains a
		# certificate on a 2xx, so it is what stops a stranger pointing any domain
		# at our Elastic IP and making us issue certificates on their behalf (which
		# is also how the ACME account burns its rate limit).
		#
		# Caddy appends ?domain=<hostname> itself.
		#
		# The compose network, NOT https://api.stg.bookingos.vn: that request would
		# loop back through this very Caddy instance while it is mid-handshake, and
		# would also depend on public DNS. `nginx:8081` serves exactly one path —
		# everything else on that listener is 404.
		ask http://nginx:8081/public/domains/tls-allowed
	}
}

# Everything terminates here and goes to the compose nginx, which routes by Host
# and keeps the storefront as its default_server.
(app) {
	# X-Forwarded-Host is set by reverse_proxy itself — stating it again only
	# earns a warning at every config load. Proto stays explicit: the nginx
	# template reads $http_x_forwarded_proto and passes it to the apps, which is
	# what makes them emit secure cookies and absolute https URLs.
	reverse_proxy nginx:80 {
		header_up X-Forwarded-Proto https
	}
}

# Explicit hosts: certificates are obtained at startup, not at first request.
{$DASHBOARD_HOST}, {$API_HOST} {
	import app
}

# Catch-all for EVERY other hostname: tenant subdomains (bookingstudio.stg…) and
# tenant custom domains alike. Both are verified rows in `tenant_domains`, so
# both pass the same `ask` check and take the same HTTP-01 path — which is why
# the wildcard certificate (and the DNS-01 plugin build it required) is gone.
https:// {
	tls {
		on_demand
	}
	import app
}

# Plain HTTP for a host Caddy has no explicit site for. Caddy answers ACME
# HTTP-01 challenges on :80 ahead of these routes, so the redirect does not
# interfere with issuing certificates.
http:// {
	redir https://{host}{uri} permanent
}
