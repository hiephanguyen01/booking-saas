# BookingOS — THE ingress. Terminates TLS and routes by Host, in one process.
#
# ONE proxy, not two. Until 2026-08-08 a compose `nginx` sat behind Caddy and
# owned the Host routing while Caddy owned only TLS. Caddy does both natively, so
# that hop is gone along with its config language, its envsubst-at-start
# rendering, its `resolver`/`set $var` dance (Caddy re-resolves upstreams itself),
# and the X-Forwarded-Proto relay that existed only because there were two layers.
#
# WHAT THAT COST, deliberately accepted: the terminator is no longer swappable.
# Putting a cloud load balancer in front now means re-expressing these routes in
# that balancer's own rule language, because they live here and nowhere else.
#
# Env, read from the same .env.<env> as the rest of the stack, so one file serves
# staging and production unchanged:
#   ACME_EMAIL      real operated mailbox — Let's Encrypt expiry warnings go here
#   DASHBOARD_HOST  admin.stg.bookingos.vn
#   API_HOST        api.stg.bookingos.vn
#   PLATFORM_BASE_DOMAIN  stg.bookingos.vn
#
# Validate against the version compose actually runs before shipping — on-demand
# syntax has moved between Caddy 2.x releases:
#
#   docker compose --env-file .env.stg -f docker-compose.deploy.yml \
#     run --rm --entrypoint caddy caddy validate --config /etc/caddy/Caddyfile
{
	email {$ACME_EMAIL}

	on_demand_tls {
		# THE gate. Caddy blocks the TLS handshake on this call and only obtains a
		# certificate on a 2xx, so it is what stops a stranger pointing any domain
		# at our Elastic IP and making us issue certificates on their behalf (which
		# is also how the ACME account burns its rate limit).
		#
		# Caddy appends ?domain=<hostname> itself.
		#
		# Straight to the API over the compose network. NOT the public
		# https://api.stg.bookingos.vn: that request would loop back through this
		# very Caddy instance while it is mid-handshake, and would also depend on
		# public DNS. The single-path `nginx:8081` listener this used to go through
		# existed only because Caddy ran outside compose and needed a published
		# port; from inside, it reaches `api` the same way the frontends do.
		ask http://api:3000/public/domains/tls-allowed
	}
}

(common) {
	# Uploads go browser → storage directly via a presigned URL, so nothing large
	# passes through here except the presign request itself.
	request_body {
		max_size 2MB
	}
}

# Explicit hosts: certificates are obtained at startup, not at first request.
#
# `reverse_proxy` passes the ORIGINAL Host through untouched, which is what the
# whole multi-tenancy rests on — the app resolves its tenant from it. It also sets
# X-Forwarded-For / -Proto / -Host itself. AUTH-001 additionally overwrites the
# application-specific login client-IP header from the direct public peer; app
# code never trusts a browser-supplied value for that header.
{$DASHBOARD_HOST} {
	import common
	reverse_proxy dashboard:3000 {
		header_up X-BookingOS-Client-IP {remote_host}
	}
}

{$API_HOST} {
	import common
	reverse_proxy api:3000 {
		header_up X-BookingOS-Client-IP {remote_host}
	}
}

# First-party platform landing. This must be explicit so Caddy obtains its
# certificate at startup instead of sending the hostname through the tenant-only
# on-demand `ask` gate. The storefront itself recognizes this Host as the
# BookingOS landing and deliberately does not resolve a tenant.
{$PLATFORM_BASE_DOMAIN} {
	import common
	reverse_proxy storefront:3000 {
		header_up X-BookingOS-Client-IP {remote_host}
	}
}

# THE DEFAULT ROUTE — deliberately last and catch-all, for EVERY other hostname:
# tenant storefront subdomains, tenant custom domains, and tenant CONSOLE hosts.
#
# The console split rides on a reserved first label rather than a per-tenant site
# block, because naming hostnames here would make every tenant onboarding a deploy —
# the same reason the storefront route is a catch-all. Caddy cannot ask the API which
# upstream a hostname wants (the on-demand `ask` hook only answers whether a
# certificate may be issued), so the prefix is what makes the decision static.
# `AddDomainUseCase` enforces both halves of the rule: a dashboard domain must start
# with `admin.`, and a storefront domain must not.
https:// {
	import common
	tls {
		on_demand
	}
	@dashboard header_regexp Host (?i)^admin\.
	handle @dashboard {
		reverse_proxy dashboard:3000 {
			header_up X-BookingOS-Client-IP {remote_host}
		}
	}
	handle {
		reverse_proxy storefront:3000 {
			header_up X-BookingOS-Client-IP {remote_host}
		}
	}
}

# Plain HTTP for a host Caddy has no explicit site for. Caddy answers ACME
# HTTP-01 challenges on :80 ahead of these routes, so the redirect does not
# interfere with issuing certificates.
http:// {
	redir https://{host}{uri} permanent
}
